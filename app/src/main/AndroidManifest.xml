<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.agritrack.fishtrack">

    <uses-feature android:name="android.hardware.location.gps" />

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:name=".FishTrackApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/FishTrack">

        <activity
            android:name=".ui.activity.ConfigActivity"
            android:screenOrientation="portrait" />
        <activity android:name=".ui.activity.wh.correlation.CorrelationCageActivity" />
        <activity
            android:name=".ui.activity.wh.correlation.CorrelationMenuActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.activity.wh.inventory.InventoryActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.activity.WhMenuActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.activity.wh.outgoing.OutgoingProcessActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.activity.wh.outgoing.OutgoingStartActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.activity.wh.incoming.IncomingProcessActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.activity.wh.incoming.IncomingStartActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.activity.process.ProcessConfirmActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.activity.process.ProcessBinsActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.activity.process.ProcessStartActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.activity.transport.TransportSupervisorConfirmActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.activity.transport.TransportDriverConfirmActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.activity.transport.TransportBinsActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.activity.transport.TransportStartActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.activity.fishing.FishingConfirmActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.activity.fishing.FishingFillBinsActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.activity.fishing.FishingDetailsActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.activity.fishing.FishingCageActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.activity.fishing.FishingTeamActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.activity.fishing.FishingBinsActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.activity.fishing.FishingStartActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.activity.TemplateActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.activity.asset.ItemAssetsListActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.activity.profile.ProfileActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.activity.HomeActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.activity.login.ForgotYourPinActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.activity.login.ForgotYourPinResultActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.activity.login.LoginActivity"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
    </application>

</manifest>
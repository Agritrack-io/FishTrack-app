<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="appSettings"
            type="io.agritrack.ui.viewmodel.ConfigViewModel" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/agri_semi_green"
        tools:context=".fragment.ApplicationSettingsFragment">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <RelativeLayout
                    android:id="@+id/dataBaseConfigLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="2dp"
                        android:background="@color/agri_semi_green"
                        android:text="@string/database_configuration"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:translationZ="0.01dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/shape_rounded_corner_with_shadow"
                        android:orientation="vertical"
                        android:paddingStart="6dp"
                        android:paddingTop="20dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:paddingStart="10dp"
                                    android:text="@string/server_ip"
                                    android:textSize="18sp" />

                                <EditText
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="8dp"
                                    android:layout_marginRight="8dp"
                                    android:layout_marginBottom="8dp"
                                    android:background="@drawable/bg_rounded_dialog_input"
                                    android:digits="0123456789."
                                    android:hint="@string/local_ip"
                                    android:inputType="number"
                                    android:maxLength="15"
                                    android:padding="2dp"
                                    android:paddingStart="6dp"
                                    android:text="@={appSettings.dbServerIP}"
                                    android:textColorHint="@color/gray"
                                    android:textSize="18sp" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:paddingStart="10dp"
                                    android:text="@string/port"
                                    android:textSize="18sp" />

                                <EditText
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="8dp"
                                    android:layout_marginRight="8dp"
                                    android:layout_marginBottom="8dp"
                                    android:background="@drawable/bg_rounded_dialog_input"
                                    android:hint="@string/default_port"
                                    android:maxLength="5"
                                    android:inputType="number"
                                    android:text="@={appSettings.dbPort}"
                                    android:padding="2dp"
                                    android:paddingStart="6dp"
                                    android:textColorHint="@color/gray"
                                    android:textSize="18sp" />

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:paddingStart="10dp"
                                    android:text="@string/label_login"
                                    android:textSize="18sp" />

                                <EditText
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="8dp"
                                    android:layout_marginRight="8dp"
                                    android:layout_marginBottom="8dp"
                                    android:background="@drawable/bg_rounded_dialog_input"
                                    android:hint="@string/username"
                                    android:text="@={appSettings.dbUser}"
                                    android:padding="2dp"
                                    android:paddingStart="6dp"
                                    android:textColorHint="@color/gray"
                                    android:textSize="18sp" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:paddingStart="10dp"
                                    android:text="@string/password"
                                    android:textSize="18sp" />

                                <EditText
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="8dp"
                                    android:layout_marginRight="8dp"
                                    android:layout_marginBottom="8dp"
                                    android:background="@drawable/bg_rounded_dialog_input"
                                    android:hint="@string/label_password_hint"
                                    android:text="@={appSettings.dbPassword}"
                                    android:padding="2dp"
                                    android:paddingStart="6dp"
                                    android:textColorHint="@color/gray"
                                    android:textSize="18sp" />

                            </LinearLayout>

                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:text="@string/database_name"
                            android:textSize="18sp" />

                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp"
                            android:layout_marginRight="8dp"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/bg_rounded_dialog_input"
                            android:hint="db"
                            android:text="@={appSettings.dbName}"
                            android:padding="2dp"
                            android:paddingStart="6dp"
                            android:textColorHint="@color/gray"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:text="@string/driver"
                            android:textSize="18sp" />

                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp"
                            android:layout_marginRight="8dp"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/bg_rounded_dialog_input"
                            android:hint="jdbc:jtds:sqlserver://"
                            android:text="@={appSettings.dbDriver}"
                            android:padding="2dp"
                            android:paddingStart="6dp"
                            android:textColorHint="@color/gray"
                            android:textSize="18sp" />

                    </LinearLayout>

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/encodingSchemeLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/listenerServiceLayout">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="2dp"
                        android:background="@color/agri_semi_green"
                        android:text="@string/encoding_scheme"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:translationZ="0.01dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/shape_rounded_corner_with_shadow"
                        android:orientation="horizontal"
                        android:paddingStart="6dp"
                        android:paddingTop="20dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:paddingStart="10dp"
                                android:text="@string/tag_prefix"
                                android:textSize="18sp" />

                            <EditText
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="8dp"
                                android:layout_marginRight="8dp"
                                android:layout_marginBottom="8dp"
                                android:background="@drawable/bg_rounded_dialog_input"
                                android:digits="0123456789ABCDEF"
                                android:hint="BE0013"
                                android:padding="2dp"
                                android:paddingStart="6dp"
                                android:text="@={appSettings.tagPrefix}"
                                android:textColorHint="@color/gray"
                                android:textSize="18sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:paddingStart="10dp"
                                android:text="@string/epc_length"
                                android:textSize="18sp" />

                            <EditText
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="8dp"
                                android:layout_marginRight="8dp"
                                android:layout_marginBottom="8dp"
                                android:background="@drawable/bg_rounded_dialog_input"
                                android:digits="0123456789"
                                android:hint="10"
                                android:padding="2dp"
                                android:paddingStart="6dp"
                                android:text="@={appSettings.varLength}"
                                android:textColorHint="@color/gray"
                                android:textSize="18sp" />

                        </LinearLayout>

                    </LinearLayout>

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/listenerServiceLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    app:layout_constraintTop_toBottomOf="@id/dataBaseConfigLayout"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="2dp"
                        android:background="@color/agri_semi_green"
                        android:text="@string/listener_service"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:translationZ="0.01dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/shape_rounded_corner_with_shadow"
                        android:orientation="horizontal"
                        android:paddingStart="6dp"
                        android:paddingTop="20dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:paddingStart="10dp"
                                android:text="@string/server_ip"
                                android:textSize="18sp" />

                            <EditText
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="8dp"
                                android:layout_marginRight="8dp"
                                android:layout_marginBottom="8dp"
                                android:background="@drawable/bg_rounded_dialog_input"
                                android:digits="0123456789."
                                android:hint="@string/local_ip"
                                android:inputType="number"
                                android:maxLength="15"
                                android:padding="2dp"
                                android:paddingStart="6dp"
                                android:text="@={appSettings.listenerIP}"
                                android:textColorHint="@color/gray"
                                android:textSize="18sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:paddingStart="10dp"
                                android:text="@string/port"
                                android:textSize="18sp" />

                            <EditText
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="8dp"
                                android:layout_marginRight="8dp"
                                android:layout_marginBottom="8dp"
                                android:background="@drawable/bg_rounded_dialog_input"
                                android:digits="0123456789"
                                android:hint="@string/default_port"
                                android:inputType="number"
                                android:maxLength="5"
                                android:padding="2dp"
                                android:paddingStart="6dp"
                                android:text="@={appSettings.listenerPort}"
                                android:textColorHint="@color/gray"
                                android:textSize="18sp" />

                        </LinearLayout>

                    </LinearLayout>

                </RelativeLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </ScrollView>
    </FrameLayout>
</layout>
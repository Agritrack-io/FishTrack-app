<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="300dp"
android:layout_height="600dp"
android:layout_margin="2dp"
android:background="@drawable/dialog_bg">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/harvest_details"
        android:textAllCaps="true"
        android:textColor="@color/agri_blue"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/tvHarvestLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvHarvestLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:gravity="left"
        android:text="@string/harvest_initiator"
        android:textColor="@color/label_blue"
        android:textSize="@dimen/text_view_font_size_medium"
        app:layout_constraintBottom_toTopOf="@+id/tvHarvest"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title" />

    <TextView
        android:id="@+id/tvHarvest"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_rounded_dialog_non_input_smooth"
        android:textAlignment="viewEnd"
        android:padding="5dp"
        android:paddingStart="10dp"
        android:textColor="@color/black"
        android:textSize="@dimen/text_view_font_size"
        app:layout_constraintBottom_toTopOf="@+id/tvCage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvHarvestLabel" />

    <TextView
        android:id="@+id/tvCage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:gravity="left"
        android:text="@string/cage"
        android:textColor="@color/label_blue"
        android:textSize="@dimen/text_view_font_size_medium"
        app:layout_constraintBottom_toTopOf="@+id/tvCageName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvHarvest" />

    <TextView
        android:id="@+id/tvCageName"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_rounded_dialog_non_input_smooth"
        android:textAlignment="viewEnd"
        android:padding="5dp"
        android:paddingStart="10dp"
        android:textColor="@color/black"
        android:textSize="@dimen/text_view_font_size"
        app:layout_constraintBottom_toTopOf="@+id/tvFishTypeLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvCage" />

    <TextView
        android:id="@+id/tvFishTypeLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:gravity="left"
        android:text="@string/fish_type"
        android:textColor="@color/label_blue"
        android:textSize="@dimen/text_view_font_size_medium"
        app:layout_constraintBottom_toTopOf="@+id/tvFishType"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvCageName" />

    <TextView
        android:id="@+id/tvFishType"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_rounded_dialog_non_input_smooth"
        android:padding="5dp"
        android:textAlignment="viewEnd"
        android:paddingStart="10dp"
        android:textColor="@color/black"
        android:textSize="@dimen/text_view_font_size"
        app:layout_constraintBottom_toTopOf="@+id/tvFishSizeLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvFishTypeLabel" />

    <TextView
        android:id="@+id/tvFishSizeLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:gravity="left"
        android:text="@string/fish_size"
        android:textColor="@color/label_blue"
        android:textSize="@dimen/text_view_font_size_medium"
        app:layout_constraintBottom_toTopOf="@+id/tvFishSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvFishType" />

    <TextView
        android:id="@+id/tvFishSize"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="50dp"
        android:background="@drawable/bg_rounded_dialog_non_input_smooth"
        android:padding="5dp"
        android:textAlignment="viewEnd"
        android:paddingStart="10dp"
        android:textColor="@color/black"
        android:textSize="@dimen/text_view_font_size"
        app:layout_constraintBottom_toTopOf="@+id/tvRequestedQuantityLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvFishSizeLabel" />

    <TextView
        android:id="@+id/tvgr"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:paddingLeft="4dp"
        android:text="gr"
        android:textAlignment="viewStart"
        android:textColor="@color/black"
        android:textSize="@dimen/text_view_font_size_medium"
        app:layout_constraintBottom_toBottomOf="@+id/tvFishSize"
        app:layout_constraintStart_toEndOf="@+id/tvFishSize"
        app:layout_constraintTop_toTopOf="@+id/tvFishSize" />

    <TextView
        android:id="@+id/tvRequestedQuantityLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:gravity="left"
        android:text="@string/requested_quantity"
        android:textColor="@color/label_blue"
        android:textSize="@dimen/text_view_font_size_medium"
        app:layout_constraintBottom_toTopOf="@+id/tvRequestedQuantity"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvFishSize" />

    <TextView
        android:id="@+id/tvRequestedQuantity"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="50dp"
        android:background="@drawable/bg_rounded_dialog_non_input_smooth"
        android:padding="5dp"
        android:textAlignment="viewEnd"
        android:paddingStart="10dp"
        android:textColor="@color/black"
        android:textSize="@dimen/text_view_font_size"
        app:layout_constraintBottom_toTopOf="@+id/tvPackagingPlantLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvRequestedQuantityLabel" />

    <TextView
        android:id="@+id/tvPackagingPlantLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:gravity="left"
        android:text="@string/packaging_plant"
        android:textColor="@color/label_blue"
        android:textSize="@dimen/text_view_font_size_medium"
        app:layout_constraintBottom_toTopOf="@+id/tvPackagingPlant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvRequestedQuantity" />

    <TextView
        android:id="@+id/tvPackagingPlant"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_rounded_dialog_non_input_smooth"
        android:padding="5dp"
        android:paddingStart="10dp"
        android:textAlignment="viewEnd"
        android:textColor="@color/black"
        android:textSize="@dimen/text_view_font_size"
        app:layout_constraintBottom_toTopOf="@+id/btnOk"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvPackagingPlantLabel" />

    <TextView
        android:id="@+id/tvKg"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:paddingLeft="4dp"
        android:text="Kg"
        android:textAlignment="viewStart"
        android:textColor="@color/black"
        android:textSize="@dimen/text_view_font_size_medium"
        app:layout_constraintBottom_toBottomOf="@+id/tvRequestedQuantity"
        app:layout_constraintStart_toEndOf="@+id/tvRequestedQuantity"
        app:layout_constraintTop_toTopOf="@+id/tvRequestedQuantity" />


    <Button
        android:id="@+id/btnOk"
        android:layout_width="90dp"
        android:layout_height="60dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/button_press_effect"
        android:text="OK"
        android:textSize="@dimen/text_view_font_size"
        android:textColor="@color/yellow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvPackagingPlant" />


</androidx.constraintlayout.widget.ConstraintLayout>
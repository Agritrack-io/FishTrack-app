<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fishingBinsLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/agri_semi_green"
    tools:context=".fish.ui.quality.receipt.ReceiptQualityMoreInfo2Activity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:background="@drawable/bg_form_screen"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fadingEdge="horizontal"
        android:paddingTop="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivSupport"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/button_press_effect"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/support" />

        <TextView
            android:id="@+id/tvTitleToolbar"
            fontPath="fonts/open_sans_semibold.ttf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="16dp"
            android:width="250sp"
            android:textAllCaps="true"
            android:gravity="center|top|fill_vertical"
            android:text="@string/freshness_evaluation"
            android:textColor="@color/yellow"
            android:textSize="@dimen/title_font_size"
            app:layout_constraintBottom_toTopOf="@+id/tvHeaderReceiptQualityMoreInfo2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="MissingPrefix" />

        <TextView
            android:id="@+id/tvHeaderReceiptQualityMoreInfo2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/agri_blue"
            android:backgroundTintMode="screen"
            android:gravity="center"
            android:textColor="@color/agri_semi_green"
            android:textSize="@dimen/subtitle_font_size"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitleToolbar"
            tools:layout_conversion_absoluteHeight="0dp"
            tools:layout_conversion_absoluteWidth="0dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/formLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/footerLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">



        <RelativeLayout
            android:id="@+id/moreInfoBLayout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent="0.70"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            app:layout_constraintBottom_toTopOf="@+id/moreInfoCLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/shape_rounded_corner_with_shadow"
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:padding="1dp">

                <TextView
                    android:id="@+id/tvCrookedMouthLabel"
                    android:layout_width="0dp"
                    app:layout_constraintWidth_percent="0.6"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="17dp"
                    android:ems="10"
                    android:paddingEnd="10dp"
                    android:text="@string/mouth_deformity"
                    android:textAlignment="viewStart"
                    android:textColor="@color/label_blue"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toTopOf="@+id/tvHeadLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <EditText
                    android:id="@+id/etCrooked"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="17dp"
                    android:background="@drawable/bg_rounded_dialog_input"
                    android:ems="4"
                    android:maxLength="3"
                    android:inputType="number"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textAlignment="center"
                    android:textColorHint="@color/black"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toTopOf="@+id/etHead"
                    app:layout_constraintStart_toEndOf="@+id/tvCrookedMouthLabel"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvCrooked"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:paddingLeft="4dp"
                    android:text="%"
                    android:textAlignment="viewStart"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toBottomOf="@+id/etCrooked"
                    app:layout_constraintStart_toEndOf="@+id/etCrooked"
                    app:layout_constraintTop_toTopOf="@+id/etCrooked" />


                <TextView
                    android:id="@+id/tvHeadLabel"
                    android:layout_width="0dp"
                    app:layout_constraintWidth_percent="0.6"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="10dp"
                    android:ems="10"
                    android:text="@string/head_deformity"
                    android:textAlignment="viewStart"
                    android:textColor="@color/label_blue"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toTopOf="@+id/tvJawLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvCrookedMouthLabel" />

                <EditText
                    android:id="@+id/etHead"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_rounded_dialog_input"
                    android:ems="4"
                    android:maxLength="3"
                    android:inputType="number"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textAlignment="center"
                    android:textColorHint="@color/black"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toTopOf="@+id/etJaw"
                    app:layout_constraintStart_toEndOf="@+id/tvHeadLabel"
                    app:layout_constraintTop_toBottomOf="@id/etCrooked" />

                <TextView
                    android:id="@+id/tvHead"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:paddingLeft="4dp"
                    android:text="%"
                    android:textAlignment="viewStart"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toBottomOf="@+id/etHead"
                    app:layout_constraintStart_toEndOf="@+id/etHead"
                    app:layout_constraintTop_toTopOf="@+id/etHead" />

                <TextView
                    android:id="@+id/tvJawLabel"
                    android:layout_width="0dp"
                    app:layout_constraintWidth_percent="0.6"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:ems="10"
                    android:text="@string/lower_jaw_extension"
                    android:textAlignment="viewStart"
                    android:textColor="@color/label_blue"
                    android:textSize="19sp"
                    app:layout_constraintBottom_toTopOf="@+id/tvParrotLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvHeadLabel" />

                <EditText
                    android:id="@+id/etJaw"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_rounded_dialog_input"
                    android:ems="4"
                    android:maxLength="3"
                    android:inputType="number"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textAlignment="center"
                    android:textColorHint="@color/black"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toTopOf="@+id/etParrot"
                    app:layout_constraintStart_toEndOf="@+id/tvJawLabel"
                    app:layout_constraintTop_toBottomOf="@id/etHead" />

                <TextView
                    android:id="@+id/tvJaw"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:paddingLeft="4dp"
                    android:text="%"
                    android:textAlignment="viewStart"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toBottomOf="@+id/etJaw"
                    app:layout_constraintStart_toEndOf="@+id/etJaw"
                    app:layout_constraintTop_toTopOf="@+id/etJaw" />

                <TextView
                    android:id="@+id/tvParrotLabel"
                    android:layout_width="0dp"
                    app:layout_constraintWidth_percent="0.6"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:ems="10"
                    android:paddingEnd="10dp"
                    android:text="@string/jaw_overlay"
                    android:textAlignment="viewStart"
                    android:textColor="@color/label_blue"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toTopOf="@+id/tvOperLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvJawLabel" />

                <EditText
                    android:id="@+id/etParrot"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_rounded_dialog_input"
                    android:ems="4"
                    android:maxLength="3"
                    android:inputType="number"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textAlignment="center"
                    android:textColorHint="@color/black"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toTopOf="@+id/etOper"
                    app:layout_constraintStart_toEndOf="@+id/tvParrotLabel"
                    app:layout_constraintTop_toBottomOf="@id/etJaw" />

                <TextView
                    android:id="@+id/tvParrot"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:paddingLeft="4dp"
                    android:text="%"
                    android:textAlignment="viewStart"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toBottomOf="@+id/etParrot"
                    app:layout_constraintStart_toEndOf="@+id/etParrot"
                    app:layout_constraintTop_toTopOf="@+id/etParrot" />

                <TextView
                    android:id="@+id/tvOperLabel"
                    android:layout_width="0dp"
                    app:layout_constraintWidth_percent="0.6"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:ems="10"
                    android:paddingEnd="10dp"
                    android:text="@string/operculum"
                    android:textAlignment="viewStart"
                    android:textColor="@color/label_blue"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toTopOf="@+id/tvLordosisLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvParrotLabel" />

                <EditText
                    android:id="@+id/etOper"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_rounded_dialog_input"
                    android:ems="4"
                    android:maxLength="3"
                    android:inputType="number"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textAlignment="center"
                    android:textColorHint="@color/black"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toTopOf="@+id/etLordosis"
                    app:layout_constraintStart_toEndOf="@+id/tvOperLabel"
                    app:layout_constraintTop_toBottomOf="@id/etParrot" />

                <TextView
                    android:id="@+id/tvOper"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:paddingLeft="4dp"
                    android:text="%"
                    android:textAlignment="viewStart"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toBottomOf="@+id/etOper"
                    app:layout_constraintStart_toEndOf="@+id/etOper"
                    app:layout_constraintTop_toTopOf="@+id/etOper" />


                <TextView
                    android:id="@+id/tvLordosisLabel"
                    android:layout_width="0dp"
                    app:layout_constraintWidth_percent="0.6"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:ems="10"
                    android:paddingEnd="10dp"
                    android:text="@string/lordosis"
                    android:textAlignment="viewStart"
                    android:textColor="@color/label_blue"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toTopOf="@+id/tvShortLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvOperLabel" />

                <EditText
                    android:id="@+id/etLordosis"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_rounded_dialog_input"
                    android:ems="4"
                    android:maxLength="3"
                    android:inputType="number"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textAlignment="center"
                    android:textColorHint="@color/black"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toTopOf="@+id/etShort"
                    app:layout_constraintStart_toEndOf="@+id/tvLordosisLabel"
                    app:layout_constraintTop_toBottomOf="@id/etOper" />

                <TextView
                    android:id="@+id/tvLordosis"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:paddingLeft="4dp"
                    android:text="%"
                    android:textAlignment="viewStart"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toBottomOf="@+id/etLordosis"
                    app:layout_constraintStart_toEndOf="@+id/etLordosis"
                    app:layout_constraintTop_toTopOf="@+id/etLordosis" />

                <TextView
                    android:id="@+id/tvShortLabel"
                    android:layout_width="0dp"
                    app:layout_constraintWidth_percent="0.6"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:ems="10"
                    android:paddingEnd="10dp"
                    android:text="@string/shortening"
                    android:textAlignment="viewStart"
                    android:textColor="@color/label_blue"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toTopOf="@+id/tvSkeletLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvLordosisLabel" />

                <EditText
                    android:id="@+id/etShort"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_rounded_dialog_input"
                    android:ems="4"
                    android:maxLength="3"
                    android:inputType="number"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textAlignment="center"
                    android:textColorHint="@color/black"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toTopOf="@+id/etSkelet"
                    app:layout_constraintStart_toEndOf="@+id/tvLordosisLabel"
                    app:layout_constraintTop_toBottomOf="@id/etLordosis" />

                <TextView
                    android:id="@+id/tvShort"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:paddingLeft="4dp"
                    android:text="%"
                    android:textAlignment="viewStart"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toBottomOf="@+id/etShort"
                    app:layout_constraintStart_toEndOf="@+id/etShort"
                    app:layout_constraintTop_toTopOf="@+id/etShort" />

                <TextView
                    android:id="@+id/tvSkeletLabel"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:ems="10"
                    android:paddingEnd="10dp"
                    android:text="@string/skeletical"
                    android:textAlignment="viewStart"
                    android:textColor="@color/label_blue"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toTopOf="@+id/tvTailLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvShortLabel"
                    app:layout_constraintWidth_percent="0.6" />

                <EditText
                    android:id="@+id/etSkelet"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_rounded_dialog_input"
                    android:ems="4"
                    android:maxLength="3"
                    android:inputType="number"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textAlignment="center"
                    android:textColorHint="@color/black"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toTopOf="@+id/etTail"
                    app:layout_constraintStart_toEndOf="@+id/tvSkeletLabel"
                    app:layout_constraintTop_toBottomOf="@id/etShort" />


                <TextView
                    android:id="@+id/tvTail"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:paddingLeft="4dp"
                    android:text="%"
                    android:textAlignment="viewStart"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toBottomOf="@+id/etSkelet"
                    app:layout_constraintStart_toEndOf="@+id/etSkelet"
                    app:layout_constraintTop_toTopOf="@+id/etSkelet" />

                <TextView
                    android:id="@+id/tvTailLabel"
                    android:layout_width="0dp"
                    app:layout_constraintWidth_percent="0.6"
                    android:layout_height="30dp"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:ems="10"
                    android:paddingEnd="10dp"
                    android:text="@string/tail_deformity"
                    android:textAlignment="viewStart"
                    android:textColor="@color/label_blue"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvSkeletLabel" />

                <EditText
                    android:id="@+id/etTail"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_rounded_dialog_input"
                    android:ems="4"
                    android:maxLength="3"
                    android:inputType="number"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textAlignment="center"
                    android:textColorHint="@color/black"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tvTailLabel"
                    app:layout_constraintTop_toBottomOf="@id/etSkelet" />

                <TextView
                    android:id="@+id/tvSkelet"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:paddingLeft="4dp"
                    android:text="%"
                    android:textAlignment="viewStart"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toBottomOf="@+id/etTail"
                    app:layout_constraintStart_toEndOf="@+id/etTail"
                    app:layout_constraintTop_toTopOf="@+id/etTail" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginStart="16dp"
                android:background="@color/agri_semi_green"
                android:paddingHorizontal="8dp"
                android:text="@string/dysmorphias"
                android:textColor="@color/label_blue"
                android:textSize="18sp" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/moreInfoCLayout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent="0.25"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/moreInfoBLayout">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="12dp"
                android:background="@drawable/shape_rounded_corner_with_shadow"
                android:orientation="vertical"
                android:padding="1dp">

                <TextView
                    android:id="@+id/tvTailDefLabel"
                    android:layout_width="0dp"
                    app:layout_constraintWidth_percent="0.6"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="17dp"
                    android:ems="10"
                    android:paddingEnd="10dp"
                    android:text="@string/tail_deformation"
                    android:textAlignment="viewStart"
                    android:textColor="@color/label_blue"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toTopOf="@+id/tvBloodyMucusLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <EditText
                    android:id="@+id/etTailDef"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="17dp"
                    android:background="@drawable/bg_rounded_dialog_input"
                    android:ems="4"
                    android:maxLength="3"
                    android:inputType="number"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textAlignment="center"
                    android:textColorHint="@color/black"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toTopOf="@+id/etHeads"
                    app:layout_constraintStart_toEndOf="@+id/tvTailDefLabel"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvTailDef"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:paddingLeft="4dp"
                    android:text="%"
                    android:textAlignment="viewStart"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toBottomOf="@+id/etTailDef"
                    app:layout_constraintStart_toEndOf="@+id/etTailDef"

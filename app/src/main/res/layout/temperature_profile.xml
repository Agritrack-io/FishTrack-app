<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:background="@drawable/list_item_bottom"
    android:clickable="true"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvLowTemp"
        android:layout_width="70dp"
        android:layout_height="40dp"
        android:paddingEnd="15dp"
        android:text="0"
        android:textAlignment="viewEnd"
        android:textColor="@android:color/darker_gray"
        android:textSize="25sp"
        app:layout_constraintEnd_toStartOf="@+id/tvTempHistogram"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvHiTemp"
        android:layout_width="70dp"
        android:layout_height="40dp"
        android:paddingEnd="15dp"
        android:text="4"
        android:textAlignment="viewEnd"
        android:textColor="@android:color/darker_gray"
        android:textSize="25sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvLowTemp" />

    <TextView
        android:id="@+id/tvAvgTemp"
        android:layout_width="70dp"
        android:layout_height="40dp"
        android:paddingEnd="15dp"
        android:text="2"
        android:textAlignment="viewEnd"
        android:textColor="@android:color/darker_gray"
        android:textSize="25sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvHiTemp" />

    <TextView
        android:id="@+id/tvTempHistogram"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:paddingTop="3dp"
        android:paddingRight="30dp"
        android:textAlignment="viewEnd"
        android:textColor="@color/black"
        android:textSize="25sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tvLowTemp"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
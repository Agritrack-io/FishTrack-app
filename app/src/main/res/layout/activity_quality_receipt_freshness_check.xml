<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fishingBinsLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/agri_semi_green"
    tools:context=".fish.ui.quality.receipt.ReceiptQualityFreshCheckActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:background="@drawable/bg_form_screen"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fadingEdge="horizontal"
        android:paddingTop="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivSupport"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/button_press_effect"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/support" />

        <TextView
            android:id="@+id/tvTitleToolbar"
            fontPath="fonts/open_sans_semibold.ttf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="16dp"
            android:width="250sp"
            android:gravity="center|top|fill_vertical"
            android:text="@string/title_quality_receipt"
            android:textColor="@color/yellow"
            android:textSize="@dimen/title_font_size"
            app:layout_constraintBottom_toTopOf="@+id/tvHeaderReceiptQualityFresh"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="MissingPrefix" />

        <TextView
            android:id="@+id/tvHeaderReceiptQualityFresh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/agri_blue"
            android:backgroundTintMode="screen"
            android:gravity="center"
            android:textColor="@color/agri_semi_green"
            android:textSize="@dimen/subtitle_font_size"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitleToolbar"
            tools:layout_conversion_absoluteHeight="0dp"
            tools:layout_conversion_absoluteWidth="0dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/formLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/footerLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerLayout">


        <RelativeLayout
            android:id="@+id/moreInfoDLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            app:layout_constraintBottom_toTopOf="@+id/moreInfoDLayouts"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/shape_rounded_corner_with_shadow"
                android:orientation="vertical"
                android:padding="1dp">

                <RelativeLayout
                    android:id="@+id/eyesLayout"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    app:layout_constraintBottom_toTopOf="@+id/gillLayout"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/shape_rounded_corner_with_shadow"
                        android:orientation="vertical"
                        android:padding="1dp">

                        <io.agritrack.philosofish.ui.custom.ToggleGroup
                            android:id="@+id/tgEyeCondition"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_alignParentTop="true"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ToggleButton
                                android:id="@+id/tbExtraEyes"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textAllCaps="true"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="EXTRA"
                                android:textOn="EXTRA"
                                android:textSize="@dimen/text_view_font_size_medium" />

                            <ToggleButton
                                android:id="@+id/tbAEyes"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="A"
                                android:textOn="A"
                                android:textSize="@dimen/text_view_font_size_medium" />

                            <ToggleButton
                                android:id="@+id/tbBEyes"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="B"
                                android:textOn="B"
                                android:textSize="@dimen/text_view_font_size_medium" />

                            <ToggleButton
                                android:id="@+id/tbFailEyes"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="@string/fail"
                                android:textOn="@string/fail"
                                android:textSize="20sp" />
                        </io.agritrack.philosofish.ui.custom.ToggleGroup>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="-1dp"
                        android:background="@color/agri_semi_green"
                        android:paddingHorizontal="8dp"
                        android:text="@string/eyes"
                        android:textColor="@color/label_blue"
                        android:textSize="18sp"
                        app:layout_constraintStart_toStartOf="parent" />

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/gillLayout"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    app:layout_constraintBottom_toBottomOf="@+id/elasticityLayout"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/eyesLayout">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/shape_rounded_corner_with_shadow"
                        android:orientation="vertical"
                        android:padding="1dp">

                        <io.agritrack.philosofish.ui.custom.ToggleGroup
                            android:id="@+id/tgGillCondition"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_alignParentTop="true"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ToggleButton
                                android:id="@+id/tbExtraGill"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textAllCaps="true"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="EXTRA"
                                android:textOn="EXTRA"
                                android:textSize="@dimen/text_view_font_size_medium" />

                            <ToggleButton
                                android:id="@+id/tbAGill"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="A"
                                android:textOn="A"
                                android:textSize="@dimen/text_view_font_size_medium" />

                            <ToggleButton
                                android:id="@+id/tbBGill"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="B"
                                android:textOn="B"
                                android:textSize="@dimen/text_view_font_size_medium" />

                            <ToggleButton
                                android:id="@+id/tbFailGill"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="@string/fail"
                                android:textOn="@string/fail"
                                android:textSize="20sp" />
                        </io.agritrack.philosofish.ui.custom.ToggleGroup>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="-2dp"
                        android:background="@color/agri_semi_green"
                        android:paddingHorizontal="8dp"
                        android:text="@string/gills"
                        android:textColor="@color/label_blue"
                        android:textSize="18sp"
                        app:layout_constraintStart_toStartOf="parent" />

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/elasticityLayout"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    app:layout_constraintBottom_toTopOf="@+id/colorLayout"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/gillLayout">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/shape_rounded_corner_with_shadow"
                        android:orientation="vertical"
                        android:padding="1dp">

                        <io.agritrack.philosofish.ui.custom.ToggleGroup
                            android:id="@+id/tgElasticityCondition"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_alignParentTop="true"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ToggleButton
                                android:id="@+id/tbExtraElasticity"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textAllCaps="true"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="EXTRA"
                                android:textOn="EXTRA"
                                android:textSize="@dimen/text_view_font_size_medium" />

                            <ToggleButton
                                android:id="@+id/tbAElasticity"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="A"
                                android:textOn="A"
                                android:textSize="@dimen/text_view_font_size_medium" />

                            <ToggleButton
                                android:id="@+id/tbBElasticity"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="B"
                                android:textOn="B"
                                android:textSize="@dimen/text_view_font_size_medium" />

                            <ToggleButton
                                android:id="@+id/tbFailElasticity"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="@string/fail"
                                android:textOn="@string/fail"
                                android:textSize="20sp" />
                        </io.agritrack.philosofish.ui.custom.ToggleGroup>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="-2dp"
                        android:background="@color/agri_semi_green"
                        android:paddingHorizontal="8dp"
                        android:text="@string/elasticity"
                        android:textColor="@color/label_blue"
                        android:textSize="18sp"
                        app:layout_constraintStart_toStartOf="parent" />

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/colorLayout"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/elasticityLayout">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/shape_rounded_corner_with_shadow"
                        android:orientation="vertical"
                        android:padding="1dp">

                        <io.agritrack.philosofish.ui.custom.ToggleGroup
                            android:id="@+id/tgColorCondition"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_alignParentTop="true"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ToggleButton
                                android:id="@+id/tbExtraColor"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textAllCaps="true"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="EXTRA"
                                android:textOn="EXTRA"
                                android:textSize="@dimen/text_view_font_size_medium" />

                            <ToggleButton
                                android:id="@+id/tbAColor"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="A"
                                android:textOn="A"
                                android:textSize="@dimen/text_view_font_size_medium" />

                            <ToggleButton
                                android:id="@+id/tbBColor"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="B"
                                android:textOn="B"
                                android:textSize="@dimen/text_view_font_size_medium" />

                            <ToggleButton
                                android:id="@+id/tbFailColor"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="@string/fail"
                                android:textOn="@string/fail"
                                android:textSize="20sp" />
                        </io.agritrack.philosofish.ui.custom.ToggleGroup>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="-2dp"
                        android:background="@color/agri_semi_green"
                        android:paddingHorizontal="8dp"
                        android:text="@string/skin_color"
                        android:textColor="@color/label_blue"
                        android:textSize="18sp"
                        app:layout_constraintStart_toStartOf="parent" />

                </RelativeLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginStart="16dp"
                android:layout_marginTop="-4dp"
                android:background="@color/agri_semi_green"
                android:paddingHorizontal="8dp"
                android:text="@string/freshness_check"
                android:textColor="@color/label_blue"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/moreInfoDLayouts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/moreInfoDLayout">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/shape_rounded_corner_with_shadow"
                android:orientation="vertical"
                android:padding="1dp">

                <HorizontalScrollView
                    android:id="@+id/gridView"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_margin="10dp"
                    android:foregroundGravity="center_vertical"
                    app:layout_constraintBottom_toTopOf="@+id/etComments"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <GridLayout
                        android:id="@+id/gdDysmorphia"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_marginTop="@dimen/margin20"
                        android:columnCount="6"
                        android:rowCount="2">

                        <TextView
                            android:layout_row="0"
                            android:layout_rowWeight="1"
                            android:layout_column="0"
                            android:layout_columnWeight="0.16"
                            android:layout_gravity="center|end"
                            android:layout_marginTop="5dp"
                            android:layout_marginBottom="5dp"
                            android:text="@string/eyes"
                            android:textAlignment="viewEnd"
                            android:textColor="@color/label_blue"
                            android:textSize="16sp" />

                        <EditText
                            android:id="@+id/disEyes"
                            android:layout_width="50dp"
                            android:layout_row="0"
                            android:layout_rowWeight="1"
                            android:layout_column="1"
                            android:layout_marginTop="10dp"
                            android:layout_columnWeight="0.26"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/bg_rounded_dialog_input"
                            android:hint="0"
                            android:inputType="number"
                            android:maxLength="3"
                            android:padding="3dp"
                            android:textAlignment="center"
                            android:textColorHint="@color/gray"
                            android:textSize="@dimen/text_view_font_size_small" />

                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_rowWeight="1"
                            android:layout_columnWeight="0.16"
                            android:layout_gravity="center|end"
                            android:layout_marginTop="5dp"
                            android:layout_marginBottom="5dp"
                            android:paddingLeft="8dp"
                            android:text="@string/tail"
                            android:textAlignment="viewEnd"

                            android:textColor="@color/label_blue"
                            android:textSize="16sp" />

                        <EditText
                            android:id="@+id/disTail"
                            android:layout_width="50dp"
                            android:layout_row="0"
                            android:layout_rowWeight="1"
                            android:layout_column="3"
                            android:layout_columnWeight="0.26"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="10dp"

                            android:background="@drawable/bg_rounded_dialog_input"
                            android:hint="0"
                            android:inputType="number"
                            android:maxLength="3"

                            android:paddingLeft="8dp"

                            android:textAlignment="center"
                            android:textColorHint="@color/gray"
                            android:textSize="@dimen/text_view_font_size_small" />

                        <TextView
                            android:layout_row="0"
                            android:layout_rowWeight="1"
                            android:layout_column="4"
                            android:layout_columnWeight="0.16"
                            android:layout_marginTop="5dp"
                            android:layout_gravity="center|end"
                            android:layout_marginBottom="5dp"
                            android:paddingLeft="8dp"
                            android:text="@string/back"
                            android:textAlignment="viewEnd"
                            android:textColor="@color/label_blue"
                            android:textSize="@dimen/text_view_font_size_small" />

                        <EditText
                            android:id="@+id/disSkeletal"
                            android:layout_width="50dp"
                            android:layout_height="wrap_content"
                            android:layout_row="0"
                            android:layout_marginTop="10dp"
                            android:layout_rowWeight="1"
                            android:layout_columnWeight="0.26"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/bg_rounded_dialog_input"
                            android:inputType="number"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:hint="0"
                            android:maxLength="3"

                            android:textAlignment="center"
                            android:textColorHint="@color/gray"
                            android:textSize="@dimen/text_view_font_size_small" />

                        <TextView
                            android:layout_rowWeight="1"
                            android:layout_columnWeight="0.16"
                            android:layout_gravity="center|end"
                            android:text="@string/blood"
                            android:paddingLeft="8dp"
                            android:textAlignment="viewEnd"
                            android:textColor="@color/label_blue"
                            android:textSize="@dimen/text_view_font_size_small" />

                        <EditText
                            android:id="@+id/disBlood"
                            android:layout_row="1"
                            android:layout_rowWeight="1"
                            android:layout_columnWeight="0.16"
                            android:background="@drawable/bg_rounded_dialog_input"
                            android:inputType="number"
                            android:maxLength="3"
                            android:padding="3dp"
                            android:hint="0"
                            android:textAlignment="center"
                            android:textColorHint="@color/gray"
                            android:textSize="@dimen/text_view_font_size_small" />

                        <TextView
                            android:layout_rowWeight="1"
                            android:layout_columnWeight="0.16"
                            android:layout_marginStart="3dp"
                            android:layout_gravity="center|end"
                            android:text="@string/mouth"
                            android:paddingLeft="8dp"
                            android:textColor="@color/label_blue"
                            android:textSize="@dimen/text_view_font_size_small" />

                        <EditText
                            android:id="@+id/disMouth"
                            android:layout_row="1"
                            android:layout_rowWeight="1"
                            android:layout_columnWeight="0.16"
                            android:background="@drawable/bg_rounded_dialog_input"
                            android:inputType="number"
                            android:padding="3dp"
                            android:hint="0"
                            android:maxLength="3"

                            android:textAlignment="center"
                            android:textColorHint="@color/gray"
                            android:textSize="@dimen/text_view_font_size_small" />

                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_row="1"
                            android:layout_column="4"
                            android:layout_columnWeight="0.66"
                            android:layout_gravity="center|end"
                            android:paddingLeft="8dp"
                            android:text="@string/gill_cover"
                            android:textAlignment="viewEnd"
                            android:textColor="@color/label_blue"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/disOper"
                            android:layout_columnWeight="0.36"
                            android:background="@drawable/bg_rounded_dialog_input"
                            android:inputType="number"
                            android:padding="3dp"
                            android:hint="0"

                            android:maxLength="3"
                            android:textAlignment="center"
                            android:textColorHint="@color/gray"
                            android:textSize="@dimen/text_view_font_size_small" />


                    </GridLayout>
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/tvArrivalLabel"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="10dp"
                    android:layout_marginHorizontal="8dp"
                    android:text="@string/other"
                    android:textAlignment="viewEnd"
                    android:textColor="@color/label_blue"
                    android:gravity="center|end"
                    android:textSize="@dimen/text_view_font_size_small"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/etComments"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/gridView"
                    app:layout_constraintVertical_bias="0.312" />

                <EditText
                    android:id="@+id/etComments"
                    android:layout_width="280dp"
                    android:layout_height="75dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_rounded_dialog_input"
                    android:inputType="textMultiLine"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:singleLine="false"
                    android:scrollHorizontally="false"

                    android:gravity="top|start"
                    android:textAlignment="viewStart"
                    android:textSize="@dimen/text_view_font_size_small"
                    app:layout_constraintHorizontal_bias="0.1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tvArrivalLabel"
                    app:layout_constraintTop_toBottomOf="@+id/gridView" />


            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginStart="16dp"
                android:layout_marginTop="-4dp"
                android:background="@color/agri_semi_green"
                android:paddingHorizontal="8dp"
                android:text="@string/dysmorphias_percentage"
                android:textColor="@color/label_blue"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent" />

        </RelativeLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/footerLayout"
        android:layout_width="0dp"
        android:layout_height="68sp"
        android:background="@drawable/border_top"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/formLayout">

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:scaleX="0.7"
            android:scaleY="0.7"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ivToReceiptConfirm"
            app:layout_constraintStart_toEndOf="@+id/ivBacktoReceiptStart"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/powered_by_agritrack" />

        <ImageView
            android:id="@+id/ivBacktoReceiptStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/button_rounded_shape_corners"
            android:padding="1dp"
            android:scaleX="1.5"
            android:scaleY="1.2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_shortcut_arrow_back" />

        <ImageView
            android:id="@+id/ivToReceiptConfirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:background="@drawable/button_rounded_shape_corners"
            android:padding="1dp"
            android:scaleX="1.5"
            android:scaleY="1.2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_shortcut_arrow_forward" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>


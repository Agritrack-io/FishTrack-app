<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fishingStartActivityLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/agri_semi_green"
    android:descendantFocusability="beforeDescendants"
    android:focusableInTouchMode="true"
    tools:context=".fish.ui.quality.receipt.ReceiptQualityInfoActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:background="@drawable/bg_form_screen"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fadingEdge="horizontal"
        android:paddingTop="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivSupport"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/button_press_effect"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/support" />

        <TextView
            android:id="@+id/tvTitleToolbar"
            fontPath="fonts/open_sans_semibold.ttf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="16dp"
            android:width="250sp"
            android:gravity="center|top|fill_vertical"
            android:text="@string/final_quality_check"
            android:textAllCaps="true"
            android:textColor="@color/yellow"
            android:textSize="@dimen/title_font_size"
            app:layout_constraintBottom_toTopOf="@+id/tvHeaderFinalQuality"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="MissingPrefix" />

        <TextView
            android:id="@+id/tvHeaderFinalQuality"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/agri_blue"
            android:backgroundTintMode="screen"
            android:gravity="center"
            android:textColor="@color/agri_semi_green"
            android:textSize="@dimen/subtitle_font_size"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitleToolbar"
            tools:layout_conversion_absoluteHeight="0dp"
            tools:layout_conversion_absoluteWidth="0dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/formLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/footerLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerLayout">


        <RelativeLayout
            android:id="@+id/moreInfoDLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            app:layout_constraintBottom_toTopOf="@id/processStartCLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/shape_rounded_corner_with_shadow"
                android:orientation="vertical"
                android:padding="1dp">

                <RelativeLayout
                    android:id="@+id/exfoLayout"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    app:layout_constraintBottom_toTopOf="@+id/paletteLayout"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/shape_rounded_corner_with_shadow"
                        android:orientation="vertical"
                        android:padding="1dp">

                        <io.agritrack.philosofish.ui.custom.ToggleGroup
                            android:id="@+id/tgExfoliation"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginHorizontal="-4dp"
                            android:layout_alignParentTop="true"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">


                            <ToggleButton
                                android:id="@+id/tbLightExfo"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:textAllCaps="true"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="@string/light"
                                android:textOn="@string/light"
                                android:textSize="20sp" />

                            <ToggleButton
                                android:id="@+id/tbMidExfo"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:textAllCaps="true"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="@string/medium"
                                android:textOn="@string/medium"
                                android:textSize="@dimen/text_view_font_size_medium" />

                            <ToggleButton
                                android:id="@+id/tbHighExfo"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:textAllCaps="true"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="@string/intense"
                                android:textOn="@string/intense"
                                android:textSize="@dimen/text_view_font_size_medium" />


                        </io.agritrack.philosofish.ui.custom.ToggleGroup>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_marginStart="16dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="-1dp"
                        android:background="@color/agri_semi_green"
                        android:paddingHorizontal="8dp"
                        android:text="@string/exfoliation"
                        android:textColor="@color/label_blue"
                        android:textSize="18sp"
                        app:layout_constraintStart_toStartOf="parent" />

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/paletteLayout"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    app:layout_constraintBottom_toTopOf="@id/boxLayout"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/exfoLayout">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/shape_rounded_corner_with_shadow"
                        android:orientation="vertical"
                        android:padding="1dp">

                        <io.agritrack.philosofish.ui.custom.ToggleGroup
                            android:id="@+id/tgPaletteCondition"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_alignParentTop="true"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ToggleButton
                                android:id="@+id/tbPaletteA"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textAllCaps="true"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="@string/typical"
                                android:textOn="@string/typical"
                                android:textSize="18sp" />

                            <ToggleButton
                                android:id="@+id/tbPaletteB"
                                android:layout_width="040dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="0.8"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="@string/problematic"
                                android:textOn="@string/problematic"
                                android:textSize="17sp" />

                            <ToggleButton
                                android:id="@+id/tbPaletteC"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="@string/correction"
                                android:textOn="@string/correction"
                                android:textSize="17sp" />


                        </io.agritrack.philosofish.ui.custom.ToggleGroup>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_marginStart="16dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="-2dp"
                        android:background="@color/agri_semi_green"
                        android:paddingHorizontal="8dp"
                        android:text="@string/palette_condition"
                        android:textColor="@color/label_blue"
                        android:textSize="18sp"
                        app:layout_constraintStart_toStartOf="parent" />

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/boxLayout"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    app:layout_constraintBottom_toTopOf="@id/adbomenLayout"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/paletteLayout">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/shape_rounded_corner_with_shadow"
                        android:orientation="vertical"
                        android:padding="1dp">

                        <io.agritrack.philosofish.ui.custom.ToggleGroup
                            android:id="@+id/tgBoxCondition"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_alignParentTop="true"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ToggleButton
                                android:id="@+id/tbBoxA"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textAllCaps="true"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="@string/typical"
                                android:textOn="@string/typical"
                                android:textSize="18sp" />

                            <ToggleButton
                                android:id="@+id/tbBoxB"
                                android:layout_width="45dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="0.8"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="@string/problematic"
                                android:textOn="@string/problematic"
                                android:textSize="17sp" />

                            <ToggleButton
                                android:id="@+id/tbBoxC"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="@string/correction"
                                android:textOn="@string/correction"
                                android:textSize="17sp"/>


                        </io.agritrack.philosofish.ui.custom.ToggleGroup>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_marginStart="16dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="-2dp"
                        android:background="@color/agri_semi_green"
                        android:paddingHorizontal="8dp"
                        android:text="@string/box_condition"
                        android:textColor="@color/label_blue"
                        android:textSize="18sp"
                        app:layout_constraintStart_toStartOf="parent" />

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/adbomenLayout"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    app:layout_constraintBottom_toTopOf="@id/hematomaLayout"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/boxLayout">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/shape_rounded_corner_with_shadow"
                        android:orientation="vertical"
                        android:padding="1dp">

                        <TextView
                            android:id="@+id/tvCylindrical"
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="4dp"
                            android:layout_marginHorizontal="10dp"
                            android:textColor="@color/agri_blue"
                            android:textStyle="bold"
                            android:text="@string/cylindrical"
                            android:textAlignment="viewEnd"
                            android:textSize="16sp"
                            app:layout_constraintHorizontal_bias="0.0"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/cbCylindrical"/>
                        <CheckBox
                            android:id="@+id/cbCylindrical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:scaleY="1.5"
                            android:scaleX="1.5"
                            android:layout_marginStart="5dp"
                            android:buttonTint="@color/agri_blue"
                            app:layout_constraintTop_toTopOf="@id/tvCylindrical"
                            app:layout_constraintBottom_toBottomOf="@id/tvCylindrical"
                            app:layout_constraintStart_toEndOf="@id/tvCylindrical"/>

                        <TextView
                            android:id="@+id/tvExpanded"
                            android:layout_width="95dp"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="4dp"
                            android:layout_marginStart="4dp"
                            android:textColor="@color/agri_blue"
                            android:textStyle="bold"
                            android:text="@string/expanded"
                            android:textAlignment="viewEnd"
                            android:textSize="16sp"
                            app:layout_constraintHorizontal_bias="0.05"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toEndOf="@id/cbCylindrical"
                            app:layout_constraintEnd_toStartOf="@id/cbExpanded" />
                        <CheckBox
                            android:id="@+id/cbExpanded"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:scaleY="1.5"
                            android:scaleX="1.5"
                            android:layout_marginStart="5dp"
                            android:buttonTint="@color/agri_blue"
                            app:layout_constraintTop_toTopOf="@id/tvExpanded"
                            app:layout_constraintBottom_toBottomOf="@id/tvExpanded"
                            app:layout_constraintStart_toEndOf="@id/tvExpanded"/>

                        <TextView
                            android:id="@+id/tvSoft"
                            android:layout_width="65dp"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="4dp"
                            android:layout_marginStart="4dp"
                            android:textColor="@color/agri_blue"
                            android:textStyle="bold"
                            android:textAlignment="viewEnd"
                            android:text="@string/soft"
                            android:textSize="16sp"
                            app:layout_constraintHorizontal_bias="0.05"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toEndOf="@id/cbExpanded"
                            app:layout_constraintEnd_toStartOf="@id/cbSoft" />
                        <CheckBox
                            android:id="@+id/cbSoft"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:scaleY="1.5"
                            android:scaleX="1.5"
                            android:layout_marginStart="5dp"
                            android:buttonTint="@color/agri_blue"
                            app:layout_constraintTop_toTopOf="@id/tvSoft"
                            app:layout_constraintBottom_toBottomOf="@id/tvSoft"
                            app:layout_constraintStart_toEndOf="@id/tvSoft"/>


                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_marginStart="16dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="-2dp"
                        android:background="@color/agri_semi_green"
                        android:paddingHorizontal="8dp"
                        android:text="@string/abdomen"
                        android:textColor="@color/label_blue"
                        android:textSize="18sp"
                        app:layout_constraintStart_toStartOf="parent" />

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/hematomaLayout"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/adbomenLayout">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/shape_rounded_corner_with_shadow"
                        android:orientation="vertical"
                        android:padding="1dp">

                        <TextView
                            android:id="@+id/tvHead"
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="4dp"
                            android:layout_marginHorizontal="10dp"
                            android:textColor="@color/agri_blue"
                            android:textStyle="bold"
                            android:text="@string/head"
                            android:textAlignment="viewEnd"
                            android:textSize="18sp"
                            app:layout_constraintHorizontal_bias="0.0"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/cbHead"/>
                        <CheckBox
                            android:id="@+id/cbHead"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:scaleY="1.5"
                            android:scaleX="1.5"
                            android:layout_marginStart="5dp"
                            android:buttonTint="@color/agri_blue"
                            app:layout_constraintTop_toTopOf="@id/tvHead"
                            app:layout_constraintBottom_toBottomOf="@id/tvHead"
                            app:layout_constraintStart_toEndOf="@id/tvHead"/>

                        <TextView
                            android:id="@+id/tvBody"
                            android:layout_width="70dp"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="4dp"
                            android:layout_marginStart="4dp"
                            android:textColor="@color/agri_blue"
                            android:textStyle="bold"
                            android:text="@string/body"
                            android:textAlignment="viewEnd"
                            android:textSize="18sp"
                            app:layout_constraintHorizontal_bias="0.05"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toEndOf="@id/cbHead"
                            app:layout_constraintEnd_toStartOf="@id/cbBody" />
                        <CheckBox
                            android:id="@+id/cbBody"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:scaleY="1.5"
                            android:scaleX="1.5"
                            android:layout_marginStart="5dp"
                            android:buttonTint="@color/agri_blue"
                            app:layout_constraintTop_toTopOf="@id/tvBody"
                            app:layout_constraintBottom_toBottomOf="@id/tvBody"
                            app:layout_constraintStart_toEndOf="@id/tvBody"/>

                        <TextView
                            android:id="@+id/tvAreas"
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="4dp"
                            android:layout_marginStart="10dp"
                            android:textColor="@color/agri_blue"
                            android:textStyle="bold"
                            android:textAlignment="viewEnd"
                            android:text="@string/areas"
                            android:textSize="18sp"
                            app:layout_constraintHorizontal_bias="0.05"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toEndOf="@id/cbBody"
                            app:layout_constraintEnd_toStartOf="@id/cbAreas" />
                        <CheckBox
                            android:id="@+id/cbAreas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:scaleY="1.5"
                            android:scaleX="1.5"
                            android:layout_marginStart="5dp"
                            android:buttonTint="@color/agri_blue"
                            app:layout_constraintTop_toTopOf="@id/tvAreas"
                            app:layout_constraintBottom_toBottomOf="@id/tvAreas"
                            app:layout_constraintStart_toEndOf="@id/tvAreas"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_marginStart="16dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="-2dp"
                        android:background="@color/agri_semi_green"
                        android:paddingHorizontal="8dp"
                        android:text="@string/hematomas"
                        android:textColor="@color/label_blue"
                        android:textSize="18sp"
                        app:layout_constraintStart_toStartOf="parent" />

                </RelativeLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginStart="16dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="-4dp"
                android:background="@color/agri_semi_green"
                android:paddingHorizontal="8dp"
                android:text="@string/general"
                android:textColor="@color/label_blue"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent" />

        </RelativeLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/processStartCLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            >

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/scanLayout"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginBottom="5dp"
                android:background="@drawable/shape_rounded_corner_with_shadow"
                android:orientation="vertical"
                app:layout_constraintHorizontal_weight="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:padding="1dp">

                <TextView
                    android:id="@+id/scan_instruction"
                    android:layout_width="155dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_marginTop="5dp"
                    android:background="@color/agri_semi_green"
                    android:gravity="center"
                    android:text="@string/scan_one_box_from_lot"
                    android:textColor="@color/label_blue"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/btnScanBin"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <Button
                    android:id="@+id/btnScanBin"
                    android:layout_width="140dp"
                    android:layout_height="80dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/button_press_effect"
                    android:paddingHorizontal="5dp"
                    android:text="@string/scan_label"
                    android:textColor="@color/yellow"
                    android:textSize="22sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.333"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/scan_instruction"
                    app:layout_constraintVertical_bias="0.0"
                    tools:layout_conversion_absoluteHeight="120dp"
                    tools:layout_conversion_absoluteWidth="0dp" />


            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="145dp"
                android:layout_marginHorizontal="3dp"
                android:layout_marginBottom="5dp"
                android:background="@drawable/shape_rounded_corner_with_shadow"
                android:orientation="vertical"
                android:padding="1dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="0.5"
                app:layout_constraintStart_toEndOf="@id/scanLayout"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/lotNumberLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="5dp"
                    android:background="@color/agri_semi_green"
                    android:text="@string/lot"
                    android:textAlignment="viewStart"
                    android:textColor="@color/label_blue"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.10" />

                <EditText
                    android:id="@+id/lotNumber"
                    android:layout_width="170dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:background="@drawable/bg_rounded_dialog_input"
                    android:padding="3dp"
                    android:textAlignment="center"
                    android:textColor="@color/label_blue"
                    android:layout_marginLeft="3dp"
                    android:textSize="20sp"
                    android:text=""
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintBottom_toBottomOf="@id/lotNumberLabel"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/lotNumberLabel"
                    app:layout_constraintTop_toTopOf="@id/lotNumberLabel"
                    />

                <TextView
                    android:id="@+id/binNumberLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:background="@color/agri_semi_green"
                    android:text="@string/lot_fishing"
                    android:textAlignment="center"
                    android:textColor="@color/label_blue"
                    android:textSize="20sp"
                    android:textAllCaps="true"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintVertical_bias="0.5" />

                <Spinner
                    android:id="@+id/spFishLot"
                    style="@style/spinner_style"
                    android:layout_width="180dp"
                    android:layout_height="35dp"
                    android:layout_marginTop="5dp"
                    android:padding="3dp"
                    android:textAlignment="center"
                    android:textColor="@color/label_blue"
                    android:textSize="20sp"
                    android:hint=""
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/binNumberLabel"
                    />


            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/footerLayout"
        android:layout_width="0dp"
        android:layout_height="68sp"
        android:background="@drawable/border_top"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/formLayout">

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:scaleX="0.7"
            android:scaleY="0.7"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ivToFinalQualityConfirm"
            app:layout_constraintStart_toEndOf="@+id/ivBackToQualityMenu"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/powered_by_agritrack" />

        <ImageView
            android:id="@+id/ivBackToQualityMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/button_rounded_shape_corners"
            android:padding="1dp"
            android:scaleX="1.5"
            android:scaleY="1.2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_shortcut_arrow_back" />

        <ImageView
            android:id="@+id/ivToFinalQualityConfirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:background="@drawable/button_rounded_shape_corners"
            android:padding="1dp"
            android:scaleX="1.5"
            android:scaleY="1.2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_shortcut_arrow_forward" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fishingStartActivityLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/agri_semi_green"
    android:descendantFocusability="beforeDescendants"
    android:focusableInTouchMode="true"
    tools:context=".fish.ui.quality.packaging.PackageQualityFreshnessActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:background="@drawable/bg_form_screen"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fadingEdge="horizontal"
        android:paddingTop="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivSupport"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/button_press_effect"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/support" />

        <TextView
            android:id="@+id/tvTitleToolbar"
            fontPath="fonts/open_sans_semibold.ttf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="16dp"
            android:width="250sp"
            android:gravity="center|top|fill_vertical"
            android:text="@string/freshness_evaluation"
            android:textAllCaps="true"
            android:textColor="@color/yellow"
            android:textSize="@dimen/title_font_size"
            app:layout_constraintBottom_toTopOf="@+id/tvHeaderPackageFreshCheck"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="MissingPrefix" />

        <TextView
            android:id="@+id/tvHeaderPackageFreshCheck"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/agri_blue"
            android:backgroundTintMode="screen"
            android:gravity="center"
            android:textColor="@color/agri_semi_green"
            android:textSize="@dimen/subtitle_font_size"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitleToolbar"
            tools:layout_conversion_absoluteHeight="0dp"
            tools:layout_conversion_absoluteWidth="0dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/formLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/footerLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerLayout">


        <RelativeLayout
            android:id="@+id/moreInfoDLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            app:layout_constraintBottom_toTopOf="@+id/processStartCLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/shape_rounded_corner_with_shadow"
                android:orientation="vertical"
                android:padding="1dp">

                <RelativeLayout
                    android:id="@+id/freshnessLayout"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toTopOf="@+id/colorLayout">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/shape_rounded_corner_with_shadow"
                        android:orientation="vertical"
                        android:padding="1dp">

                        <io.agritrack.philosofish.ui.custom.ToggleGroup
                            android:id="@+id/tgFreshCondition"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_alignParentTop="true"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ToggleButton
                                android:id="@+id/tbExtraFresh"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textAllCaps="true"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="EXTRA"
                                android:textOn="EXTRA"
                                android:textSize="@dimen/text_view_font_size_medium" />

                            <ToggleButton
                                android:id="@+id/tbAFresh"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="A"
                                android:textOn="A"
                                android:textSize="@dimen/text_view_font_size_medium" />

                            <ToggleButton
                                android:id="@+id/tbBFresh"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="B"
                                android:textOn="B"
                                android:textSize="@dimen/text_view_font_size_medium" />

                            <ToggleButton
                                android:id="@+id/tbFailFresh"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="@string/fail"
                                android:textOn="@string/fail"
                                android:textSize="20sp" />
                        </io.agritrack.philosofish.ui.custom.ToggleGroup>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_marginStart="16dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="-2dp"
                        android:background="@color/agri_semi_green"
                        android:paddingHorizontal="8dp"
                        android:text="@string/freshness"
                        android:textColor="@color/label_blue"
                        android:textSize="18sp"
                        app:layout_constraintStart_toStartOf="parent" />

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/colorLayout"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    app:layout_constraintBottom_toTopOf="@+id/eyesLayout"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/freshnessLayout">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/shape_rounded_corner_with_shadow"
                        android:orientation="vertical"
                        android:padding="1dp">

                        <io.agritrack.philosofish.ui.custom.ToggleGroup
                            android:id="@+id/tgSkinCondition"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_alignParentTop="true"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ToggleButton
                                android:id="@+id/tbExtraSkin"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textAllCaps="true"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="4"
                                android:textOn="4"
                                android:textSize="@dimen/text_view_font_size_medium" />

                            <ToggleButton
                                android:id="@+id/tbASkin"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="3"
                                android:textOn="3"
                                android:textSize="@dimen/text_view_font_size_medium" />

                            <ToggleButton
                                android:id="@+id/tbBSkin"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="2"
                                android:textOn="2"
                                android:textSize="@dimen/text_view_font_size_medium" />

                            <ToggleButton
                                android:id="@+id/tbFailSkin"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="1"
                                android:textOn="1"
                                android:textSize="20sp" />
                        </io.agritrack.philosofish.ui.custom.ToggleGroup>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_marginStart="16dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="-2dp"
                        android:background="@color/agri_semi_green"
                        android:paddingHorizontal="8dp"
                        android:text="@string/skin_condition"
                        android:textColor="@color/label_blue"
                        android:textSize="18sp"
                        app:layout_constraintStart_toStartOf="parent" />

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/eyesLayout"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    app:layout_constraintBottom_toTopOf="@+id/gillLayout"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/colorLayout">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/shape_rounded_corner_with_shadow"
                        android:orientation="vertical"
                        android:padding="1dp">

                        <io.agritrack.philosofish.ui.custom.ToggleGroup
                            android:id="@+id/tgEyeCondition"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_alignParentTop="true"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ToggleButton
                                android:id="@+id/tbExtraEyes"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textAllCaps="true"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="4"
                                android:textOn="4"
                                android:textSize="@dimen/text_view_font_size_medium" />

                            <ToggleButton
                                android:id="@+id/tbAEyes"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="3"
                                android:textOn="3"
                                android:textSize="@dimen/text_view_font_size_medium" />

                            <ToggleButton
                                android:id="@+id/tbBEyes"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="2"
                                android:textOn="2"
                                android:textSize="@dimen/text_view_font_size_medium" />

                            <ToggleButton
                                android:id="@+id/tbFailEyes"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="1"
                                android:textOn="1"
                                android:textSize="20sp" />
                        </io.agritrack.philosofish.ui.custom.ToggleGroup>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_marginStart="16dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="-1dp"
                        android:background="@color/agri_semi_green"
                        android:paddingHorizontal="8dp"
                        android:text="@string/eye_condition"
                        android:textColor="@color/label_blue"
                        android:textSize="18sp"
                        app:layout_constraintStart_toStartOf="parent" />

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/gillLayout"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    app:layout_constraintBottom_toTopOf="@+id/overallGrade"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/eyesLayout">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/shape_rounded_corner_with_shadow"
                        android:orientation="vertical"
                        android:padding="1dp">

                        <io.agritrack.philosofish.ui.custom.ToggleGroup
                            android:id="@+id/tgGillCondition"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_alignParentTop="true"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ToggleButton
                                android:id="@+id/tbExtraGill"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textAllCaps="true"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="4"
                                android:textOn="4"
                                android:textSize="@dimen/text_view_font_size_medium" />

                            <ToggleButton
                                android:id="@+id/tbAGill"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="3"
                                android:textOn="3"
                                android:textSize="@dimen/text_view_font_size_medium" />

                            <ToggleButton
                                android:id="@+id/tbBGill"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="2"
                                android:textOn="2"
                                android:textSize="@dimen/text_view_font_size_medium" />

                            <ToggleButton
                                android:id="@+id/tbFailGill"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/togglebutton_selector"
                                android:gravity="center"
                                android:textColor="@drawable/button_text_color"
                                android:textOff="1"
                                android:textOn="1"
                                android:textSize="20sp" />
                        </io.agritrack.philosofish.ui.custom.ToggleGroup>

                    </androidx.constraintlayout.widget.ConstraintLayout>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_marginStart="16dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="-2dp"
                        android:background="@color/agri_semi_green"
                        android:paddingHorizontal="8dp"
                        android:text="@string/gill_condition"
                        android:textColor="@color/label_blue"
                        android:textSize="18sp"
                        app:layout_constraintStart_toStartOf="parent" />

                </RelativeLayout>

                <TextView
                    android:id="@+id/overallGradeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="15dp"
                    android:textColor="@color/label_blue"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintHorizontal_bias="0.3"
                    android:text="@string/overall_evaluation"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/gillLayout" />

                <TextView
                    android:id="@+id/overallGrade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    app:layout_constraintHorizontal_bias="0.1"
                    android:textColor="@color/label_blue"
                    android:textSize="18sp"
                    android:padding="5dp"
                    android:background="@drawable/shape_rounded_corner_with_shadow"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="@+id/overallGradeLabel"
                    app:layout_constraintStart_toEndOf="@+id/overallGradeLabel"
                    app:layout_constraintBottom_toBottomOf="@+id/overallGradeLabel" />

                <TextView
                    android:id="@+id/outOfTwelve"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    app:layout_constraintHorizontal_bias="0.1"
                    android:textColor="@color/label_blue"
                    android:text="/12"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="@+id/overallGrade"
                    app:layout_constraintStart_toEndOf="@+id/overallGrade"
                    app:layout_constraintBottom_toBottomOf="@+id/overallGrade" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginStart="16dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="-4dp"
                android:background="@color/agri_semi_green"
                android:paddingHorizontal="8dp"
                android:text="@string/freshness_check"
                android:textColor="@color/label_blue"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent" />


        </RelativeLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/processStartCLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/moreInfoDLayout">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/scanLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:background="@drawable/shape_rounded_corner_with_shadow"
                android:orientation="vertical"
                app:layout_constraintHorizontal_weight="0.4"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:padding="1dp">

                <TextView
                    android:id="@+id/scan_instruction"
                    android:layout_width="155dp"
                    android:layout_marginHorizontal="2dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_marginTop="5dp"
                    android:background="@color/agri_semi_green"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:text="@string/scan_one_box_from_lot"
                    android:textColor="@color/label_blue"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@+id/btnScanBin"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <Button
                    android:id="@+id/btnScanBin"
                    android:layout_width="145dp"
                    android:layout_height="80dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="5dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/button_press_effect"
                    android:paddingHorizontal="5dp"
                    android:text="@string/scan_label"
                    android:textColor="@color/yellow"
                    android:textSize="18sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.333"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/scan_instruction"
                    app:layout_constraintVertical_bias="0.0"
                    tools:layout_conversion_absoluteHeight="120dp"
                    tools:layout_conversion_absoluteWidth="0dp" />


            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="145dp"
                android:layout_marginHorizontal="3dp"
                android:layout_marginBottom="5dp"
                android:background="@drawable/shape_rounded_corner_with_shadow"
                android:orientation="vertical"
                android:padding="1dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="0.5"
                app:layout_constraintStart_toEndOf="@id/scanLayout"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/lotNumberLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="5dp"
                    android:background="@color/agri_semi_green"
                    android:text="@string/lot"
                    android:textAlignment="viewStart"
                    android:textColor="@color/label_blue"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.10" />

                <EditText
                    android:id="@+id/lotNumber"
                    android:layout_width="170dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:background="@drawable/bg_rounded_dialog_input"
                    android:padding="3dp"
                    android:textAlignment="center"
                    android:textColor="@color/label_blue"
                    android:layout_marginLeft="3dp"
                    android:textSize="20sp"
                    android:text=""
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintBottom_toBottomOf="@id/lotNumberLabel"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/lotNumberLabel"
                    app:layout_constraintTop_toTopOf="@id/lotNumberLabel" />

                <TextView
                    android:id="@+id/binNumberLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:background="@color/agri_semi_green"
                    android:text="@string/lot_fishing"
                    android:textAlignment="center"
                    android:textColor="@color/label_blue"
                    android:textSize="20sp"
                    android:textAllCaps="true"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintVertical_bias="0.5" />

                <Spinner
                    android:id="@+id/spFishLot"
                    style="@style/spinner_style"
                    android:layout_width="180dp"
                    android:layout_height="35dp"
                    android:layout_marginTop="5dp"
                    android:padding="3dp"
                    android:textAlignment="center"
                    android:textColor="@color/label_blue"
                    android:textSize="20sp"
                    android:hint=""
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/binNumberLabel" />


            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/footerLayout"
        android:layout_width="0dp"
        android:layout_height="68sp"
        android:background="@drawable/border_top"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/formLayout">

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:scaleX="0.7"
            android:scaleY="0.7"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ivToPackageQualityDysmorphias"
            app:layout_constraintStart_toEndOf="@+id/ivBackToPackageQualityMenu"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/powered_by_agritrack" />

        <ImageView
            android:id="@+id/ivBackToPackageQualityMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/button_rounded_shape_corners"
            android:padding="1dp"
            android:scaleX="1.5"
            android:scaleY="1.2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_shortcut_arrow_back" />

        <ImageView
            android:id="@+id/ivToPackageQualityDysmorphias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:background="@drawable/button_rounded_shape_corners"
            android:padding="1dp"
            android:scaleX="1.5"
            android:scaleY="1.2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_shortcut_arrow_forward" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cvParent"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:padding="5dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout1"
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:background="@drawable/border_left"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/constraintLayout2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvRecyclerItemSNo"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:paddingTop="3dp"
            android:paddingEnd="15dp"
            android:textAlignment="viewEnd"
            android:textColor="@color/agri_yellow"
            android:textSize="20sp"
            app:layout_constraintEnd_toStartOf="@+id/tvRfid"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvRfid"
            fontPath="fonts/open_sans_extra_bold.ttf"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="@string/item_home_adapter_menu_item"
            android:textAlignment="center"
            android:textColor="@color/yellow"
            android:textSize="20sp"
            android:textStyle="normal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvRecyclerItemSNo"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="MissingPrefix" />

        <TextView
            android:id="@+id/tvBinWeightLabel"
            fontPath="fonts/open_sans_extra_bold.ttf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif"
            android:text="@string/weight_bin"
            android:textAlignment="center"
            android:textColor="@color/yellow"
            android:textSize="20sp"
            android:textStyle="normal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="MissingPrefix" />

        <EditText
            android:id="@+id/etBinWeight"
            fontPath="fonts/open_sans_extra_bold.ttf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:inputType="numberDecimal"
            android:textColor="@color/yellow"
            android:completionThreshold="1"
            android:imeOptions="actionDone"
            android:fontFamily="sans-serif"
            android:textAlignment="center"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvBinWeightLabel"
            tools:ignore="MissingPrefix" />

        <TextView
            android:id="@+id/tvKg"
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:paddingLeft="4dp"
            android:text="Kg"
            android:textAlignment="viewStart"
            android:textColor="@color/yellow"
            android:textSize="@dimen/text_view_font_size_medium"
            app:layout_constraintBottom_toBottomOf="@+id/etBinWeight"
            app:layout_constraintStart_toEndOf="@+id/etBinWeight"
            app:layout_constraintTop_toTopOf="@+id/etBinWeight" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:background="@drawable/border_left"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/constraintLayout1"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/ibAddTemp"
            android:layout_width="48sp"
            android:layout_height="48sp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/yellow"
            android:src="@drawable/quality"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/etBinTemperature"
            fontPath="fonts/open_sans_extra_bold.ttf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:completionThreshold="1"
            android:fontFamily="sans-serif"
            android:imeOptions="actionDone"
            android:inputType="numberDecimal"
            android:textAlignment="center"
            android:textColor="@color/yellow"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ibAddTemp"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="MissingPrefix" />

        <TextView
            android:id="@+id/tvCelsius"
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:paddingLeft="4dp"
            android:text="°C"
            android:textAlignment="viewStart"
            android:textColor="@color/yellow"
            android:textSize="@dimen/text_view_font_size_medium"
            app:layout_constraintBottom_toBottomOf="@+id/etBinTemperature"
            app:layout_constraintStart_toEndOf="@+id/etBinTemperature"
            app:layout_constraintTop_toTopOf="@+id/etBinTemperature" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:id="@+id/fishingBinsLayout"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="@color/agri_semi_green"
tools:context=".fish.ui.quality.receipt.ReceiptQualityMoreInfo3Activity">

<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/headerLayout"
    android:layout_width="match_parent"
    android:layout_height="75dp"
    android:background="@drawable/bg_form_screen"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fadingEdge="horizontal"
    android:paddingTop="0dp"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <ImageView
        android:id="@+id/ivSupport"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/button_press_effect"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/support" />

    <TextView
        android:id="@+id/tvTitleToolbar"
        fontPath="fonts/open_sans_semibold.ttf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="16dp"
        android:width="250sp"
        android:gravity="center|top|fill_vertical"
        android:text="@string/title_quality_receipt"
        android:textColor="@color/yellow"
        android:textSize="@dimen/title_font_size"
        app:layout_constraintBottom_toTopOf="@+id/tvHeaderReceiptQualityMoreInfo3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingPrefix" />

    <TextView
        android:id="@+id/tvHeaderReceiptQualityMoreInfo3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/agri_blue"
        android:backgroundTintMode="screen"
        android:gravity="center"
        android:textColor="@color/agri_semi_green"
        android:textSize="@dimen/subtitle_font_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitleToolbar"
        tools:layout_conversion_absoluteHeight="0dp"
        tools:layout_conversion_absoluteWidth="0dp" />

</androidx.constraintlayout.widget.ConstraintLayout>

<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/formLayout"
    android:layout_width="0dp"
    android:layout_height="0dp"
    app:layout_constraintBottom_toTopOf="@+id/footerLayout"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@id/headerLayout">

    <RelativeLayout
        android:id="@+id/moreInfoALayout"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@+id/moreInfoBLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="12dp"
            android:background="@drawable/shape_rounded_corner_with_shadow"
            android:orientation="vertical"
            android:padding="1dp">

            <TextView
                android:id="@+id/tvNoHematomaLabel"
                android:layout_width="220dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="16dp"
                android:ems="10"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/no_hem"
                android:textAlignment="viewStart"
                android:textColor="@color/label_blue"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toTopOf="@+id/tvLightHematomaLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/etNoHematoma"
                android:layout_width="70dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_rounded_dialog_input"
                android:ems="10"
                android:inputType="number"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textAlignment="viewEnd"
                android:textColorHint="@color/black"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toTopOf="@+id/etLightHematoma"
                app:layout_constraintStart_toEndOf="@+id/tvNoHematomaLabel"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvNoHematoma"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:paddingLeft="4dp"
                android:text="%"
                android:textAlignment="viewStart"
                android:textColor="@color/black"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toBottomOf="@+id/etNoHematoma"
                app:layout_constraintStart_toEndOf="@+id/etNoHematoma"
                app:layout_constraintTop_toTopOf="@+id/etNoHematoma" />

            <TextView
                android:id="@+id/tvLightHematomaLabel"
                android:layout_width="220dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:ems="10"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/light_hem"
                android:textAlignment="viewStart"
                android:textColor="@color/label_blue"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toTopOf="@+id/tvHeavyHematomaLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvNoHematomaLabel" />

            <EditText
                android:id="@+id/etLightHematoma"
                android:layout_width="70dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_rounded_dialog_input"
                android:ems="10"
                android:inputType="number"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textAlignment="viewEnd"
                android:textColorHint="@color/black"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toTopOf="@+id/etHeavyHematoma"
                app:layout_constraintStart_toEndOf="@+id/tvLightHematomaLabel"
                app:layout_constraintTop_toBottomOf="@+id/etNoHematoma" />

            <TextView
                android:id="@+id/tvLightHematoma"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:paddingLeft="4dp"
                android:text="%"
                android:textAlignment="viewStart"
                android:textColor="@color/black"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toBottomOf="@+id/etLightHematoma"
                app:layout_constraintStart_toEndOf="@+id/etLightHematoma"
                app:layout_constraintTop_toTopOf="@+id/etLightHematoma" />

            <TextView
                android:id="@+id/tvHeavyHematomaLabel"
                android:layout_width="220dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:ems="10"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/severe_hem"
                android:textAlignment="viewStart"
                android:textColor="@color/label_blue"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvLightHematomaLabel" />

            <EditText
                android:id="@+id/etHeavyHematoma"
                android:layout_width="70dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_rounded_dialog_input"
                android:ems="10"
                android:inputType="number"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textAlignment="viewEnd"
                android:textColorHint="@color/black"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tvHeavyHematomaLabel"
                app:layout_constraintTop_toBottomOf="@+id/etLightHematoma" />

            <TextView
                android:id="@+id/tvHeavyHematoma"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:paddingLeft="4dp"
                android:text="%"
                android:textAlignment="viewStart"
                android:textColor="@color/black"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toBottomOf="@+id/etHeavyHematoma"
                app:layout_constraintStart_toEndOf="@+id/etHeavyHematoma"
                app:layout_constraintTop_toTopOf="@+id/etHeavyHematoma" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginStart="16dp"
            android:background="@color/agri_semi_green"
            android:paddingHorizontal="8dp"
            android:text="@string/hematomas"
            android:textColor="@color/label_blue"
            android:textSize="18sp" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/moreInfoBLayout"
        android:layout_width="0dp"
        android:layout_height="280dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@+id/moreInfoCLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/moreInfoALayout">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="12dp"
            android:background="@drawable/shape_rounded_corner_with_shadow"
            android:orientation="vertical"
            android:padding="1dp">

            <TextView
                android:id="@+id/tvPinkLabel"
                android:layout_width="220dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="16dp"
                android:ems="10"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/pink"
                android:textAlignment="viewStart"
                android:textColor="@color/label_blue"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toTopOf="@+id/tvDarkLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/etPink"
                android:layout_width="70dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_rounded_dialog_input"
                android:ems="10"
                android:inputType="number"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textAlignment="viewEnd"
                android:textColorHint="@color/black"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toTopOf="@+id/etDark"
                app:layout_constraintStart_toEndOf="@+id/tvPinkLabel"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvPink"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:paddingLeft="4dp"
                android:text="%"
                android:textAlignment="viewStart"
                android:textColor="@color/black"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toBottomOf="@+id/etPink"
                app:layout_constraintStart_toEndOf="@+id/etPink"
                app:layout_constraintTop_toTopOf="@+id/etPink" />

            <TextView
                android:id="@+id/tvDarkLabel"
                android:layout_width="220dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:ems="10"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/dark"
                android:textAlignment="viewStart"
                android:textColor="@color/label_blue"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toTopOf="@+id/tvWhiteLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvPinkLabel" />

            <EditText
                android:id="@+id/etDark"
                android:layout_width="70dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_rounded_dialog_input"
                android:ems="10"
                android:inputType="number"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textAlignment="viewEnd"
                android:textColorHint="@color/black"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toTopOf="@+id/etWhite"
                app:layout_constraintStart_toEndOf="@+id/tvDarkLabel"
                app:layout_constraintTop_toBottomOf="@+id/etPink" />

            <TextView
                android:id="@+id/tvDark"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:paddingLeft="4dp"
                android:text="%"
                android:textAlignment="viewStart"
                android:textColor="@color/black"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toBottomOf="@+id/etDark"
                app:layout_constraintStart_toEndOf="@+id/etDark"
                app:layout_constraintTop_toTopOf="@+id/etDark" />

            <TextView
                android:id="@+id/tvWhiteLabel"
                android:layout_width="220dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:ems="10"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/white"
                android:textAlignment="viewStart"
                android:textColor="@color/label_blue"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toTopOf="@+id/tvUncoloredLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvDarkLabel" />

            <EditText
                android:id="@+id/etWhite"
                android:layout_width="70dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_rounded_dialog_input"
                android:ems="10"
                android:inputType="number"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textAlignment="viewEnd"
                android:textColorHint="@color/black"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toTopOf="@+id/etUncolored"
                app:layout_constraintStart_toEndOf="@+id/tvWhiteLabel"
                app:layout_constraintTop_toBottomOf="@+id/etDark" />

            <TextView
                android:id="@+id/tvWhite"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:paddingLeft="4dp"
                android:text="%"
                android:textAlignment="viewStart"
                android:textColor="@color/black"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toBottomOf="@+id/etWhite"
                app:layout_constraintStart_toEndOf="@+id/etWhite"
                app:layout_constraintTop_toTopOf="@+id/etWhite" />

            <TextView
                android:id="@+id/tvUncoloredLabel"
                android:layout_width="220dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:ems="10"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/uncolored"
                android:textAlignment="viewStart"
                android:textColor="@color/label_blue"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toTopOf="@+id/tvHematomasLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvWhiteLabel" />

            <EditText
                android:id="@+id/etUncolored"
                android:layout_width="70dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_rounded_dialog_input"
                android:ems="10"
                android:inputType="number"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textAlignment="viewEnd"
                android:textColorHint="@color/black"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toTopOf="@+id/etHematomas"
                app:layout_constraintStart_toEndOf="@+id/tvUncoloredLabel"
                app:layout_constraintTop_toBottomOf="@+id/etWhite" />

            <TextView
                android:id="@+id/tvUncolored"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:paddingLeft="4dp"
                android:text="%"
                android:textAlignment="viewStart"
                android:textColor="@color/black"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toBottomOf="@+id/etUncolored"
                app:layout_constraintStart_toEndOf="@+id/etUncolored"
                app:layout_constraintTop_toTopOf="@+id/etUncolored" />

            <TextView
                android:id="@+id/tvHematomasLabel"
                android:layout_width="220dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:ems="10"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/hematomas"
                android:textAlignment="viewStart"
                android:textColor="@color/label_blue"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toTopOf="@+id/tvMucusLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvUncoloredLabel" />

            <EditText
                android:id="@+id/etHematomas"
                android:layout_width="70dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_rounded_dialog_input"
                android:ems="10"
                android:inputType="number"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textAlignment="viewEnd"
                android:textColorHint="@color/black"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toTopOf="@+id/etMucus"
                app:layout_constraintStart_toEndOf="@+id/tvHematomasLabel"
                app:layout_constraintTop_toBottomOf="@+id/etUncolored" />

            <TextView
                android:id="@+id/tvHematomas"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:paddingLeft="4dp"
                android:text="%"
                android:textAlignment="viewStart"
                android:textColor="@color/black"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toBottomOf="@+id/etHematomas"
                app:layout_constraintStart_toEndOf="@+id/etHematomas"
                app:layout_constraintTop_toTopOf="@+id/etHematomas" />

            <TextView
                android:id="@+id/tvMucusLabel"
                android:layout_width="220dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                android:ems="10"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/mucus"
                android:textAlignment="viewStart"
                android:textColor="@color/label_blue"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvHematomasLabel" />

            <EditText
                android:id="@+id/etMucus"
                android:layout_width="70dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_rounded_dialog_input"
                android:ems="10"
                android:inputType="number"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textAlignment="viewEnd"
                android:textColorHint="@color/black"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tvMucusLabel"
                app:layout_constraintTop_toBottomOf="@+id/etHematomas" />

            <TextView
                android:id="@+id/tvMucus"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:paddingLeft="4dp"
                android:text="%"
                android:textAlignment="viewStart"
                android:textColor="@color/black"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toBottomOf="@+id/etMucus"
                app:layout_constraintStart_toEndOf="@+id/etMucus"
                app:layout_constraintTop_toTopOf="@+id/etMucus" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginStart="16dp"
            android:background="@color/agri_semi_green"
            android:paddingHorizontal="8dp"
            android:text="@string/gills"
            android:textColor="@color/label_blue"
            android:textSize="18sp" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/moreInfoCLayout"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/moreInfoBLayout">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="12dp"
            android:background="@drawable/shape_rounded_corner_with_shadow"
            android:orientation="vertical"
            android:padding="1dp">

            <TextView
                android:id="@+id/tvProblematicFishLabel"
                android:layout_width="220dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:ems="10"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/defective_fish"
                android:textAlignment="viewStart"
                android:textColor="@color/label_blue"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toTopOf="@+id/tvEvaluationLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/etProblematicFish"
                android:layout_width="70dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_rounded_dialog_input"
                android:ems="10"
                android:inputType="number"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textAlignment="viewEnd"
                android:textColorHint="@color/black"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toTopOf="@+id/rgTotalEvaluation"
                app:layout_constraintStart_toEndOf="@+id/tvProblematicFishLabel"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvProblematicFish"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:paddingLeft="4dp"
                android:text="%"
                android:textAlignment="viewStart"
                android:textColor="@color/black"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toBottomOf="@+id/etProblematicFish"
                app:layout_constraintStart_toEndOf="@+id/etProblematicFish"
                app:layout_constraintTop_toTopOf="@+id/etProblematicFish" />

            <TextView
                android:id="@+id/tvEvaluationLabel"
                android:layout_width="180dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:ems="10"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textAlignment="viewStart"
                android:textColor="@color/label_blue"
                android:textSize="@dimen/text_view_font_size_medium"
                android:text="@string/overall_evaluation"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvProblematicFishLabel" />

            <RadioGroup
                android:id="@+id/rgTotalEvaluation"
                android:layout_width="200dp"
                android:layout_height="35dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tvEvaluationLabel"
                app:layout_constraintTop_toBottomOf="@+id/etProblematicFish">

                <RadioButton
                    android:id="@+id/simpleRadioButton1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="oneRadioButtonClicked"
                    android:text="1" />

                <RadioButton
                    android:id="@+id/simpleRadioButton2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="oneRadioButtonClicked"
                    android:text="2" />

                <RadioButton
                    android:id="@+id/simpleRadioButton3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="oneRadioButtonClicked"
                    android:text="3" />

                <RadioButton
                    android:id="@+id/simpleRadioButton4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="oneRadioButtonClicked"
                    android:text="4" />

                <RadioButton
                    android:id="@+id/simpleRadioButton5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="oneRadioButtonClicked"
                    android:text="5" />
            </RadioGroup>



        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginStart="16dp"
            android:background="@color/agri_semi_green"
            android:paddingHorizontal="8dp"
            android:text="@string/percentages"
            android:textColor="@color/label_blue"
            android:textSize="18sp" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/footerLayout"
    android:layout_width="0dp"
    android:layout_height="68sp"
    android:background="@drawable/border_top"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/formLayout">

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:scaleX="0.7"
        android:scaleY="0.7"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ivToConfirm"
        app:layout_constraintStart_toEndOf="@+id/ivBackToPackageQualityMoreInfo2"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/powered_by_agritrack" />

    <ImageView
        android:id="@+id/ivBackToPackageQualityMoreInfo2"
        android:layout_width="wrap_content"

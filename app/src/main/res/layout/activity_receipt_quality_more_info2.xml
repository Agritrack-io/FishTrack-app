<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fishingBinsLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/agri_semi_green"
    tools:context=".fish.ui.quality.receipt.ReceiptQualityMoreInfo2Activity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:background="@drawable/bg_form_screen"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fadingEdge="horizontal"
        android:paddingTop="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivSupport"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/button_press_effect"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/support" />

        <TextView
            android:id="@+id/tvTitleToolbar"
            fontPath="fonts/open_sans_semibold.ttf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="16dp"
            android:width="250sp"
            android:gravity="center|top|fill_vertical"
            android:text="@string/title_quality_receipt"
            android:textColor="@color/yellow"
            android:textSize="@dimen/title_font_size"
            app:layout_constraintBottom_toTopOf="@+id/tvHeaderReceiptQualityMoreInfo2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="MissingPrefix" />

        <TextView
            android:id="@+id/tvHeaderReceiptQualityMoreInfo2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/agri_blue"
            android:backgroundTintMode="screen"
            android:gravity="center"
            android:textColor="@color/agri_semi_green"
            android:textSize="@dimen/subtitle_font_size"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitleToolbar"
            tools:layout_conversion_absoluteHeight="0dp"
            tools:layout_conversion_absoluteWidth="0dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/formLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/footerLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <RelativeLayout
            android:id="@+id/moreInfoALayout"
            android:layout_width="0dp"
            android:layout_height="110dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            app:layout_constraintBottom_toTopOf="@+id/moreInfoBLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="12dp"
                android:background="@drawable/shape_rounded_corner_with_shadow"
                android:orientation="vertical"
                android:padding="1dp">

                <io.agritrack.philosofish.ui.custom.ToggleGroup
                    android:id="@+id/tgSmellCondition"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_alignParentBottom="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ToggleButton
                        android:id="@+id/tbFreshSmell"
                        android:layout_width="70dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="5dp"
                        android:layout_marginTop="16dp"
                        android:layout_weight="1"
                        android:background="@drawable/togglebutton_selector"
                        android:gravity="center"
                        android:textColor="@drawable/button_text_color"
                        android:textOff="@string/fresh_metallic"
                        android:textOn="@string/fresh_metallic"
                        android:textSize="@dimen/text_view_font_size_small" />

                    <ToggleButton
                        android:id="@+id/tbNoSmell"
                        android:layout_width="70dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="5dp"
                        android:layout_marginTop="25dp"
                        android:layout_weight="1"
                        android:background="@drawable/togglebutton_selector"
                        android:gravity="center"
                        android:textColor="@drawable/button_text_color"
                        android:textOff="@string/odorless"
                        android:textOn="@string/odorless"
                        android:textSize="@dimen/text_view_font_size_small" />

                    <ToggleButton
                        android:id="@+id/tbLightBadSmell"
                        android:layout_width="70dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="5dp"
                        android:layout_marginTop="16dp"
                        android:layout_weight="1"
                        android:background="@drawable/togglebutton_selector"
                        android:gravity="center"
                        android:textColor="@drawable/button_text_color"
                        android:textOff="@string/light_stinky"
                        android:textOn="@string/light_stinky"
                        android:textSize="@dimen/text_view_font_size_small" />

                    <ToggleButton
                        android:id="@+id/tbHeavyBadSmell"
                        android:layout_width="70dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="5dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/togglebutton_selector"
                        android:gravity="center"
                        android:textColor="@drawable/button_text_color"
                        android:textOff="@string/heavy_stinky"
                        android:textOn="@string/heavy_stinky"
                        android:textSize="@dimen/text_view_font_size_small" />
                </io.agritrack.philosofish.ui.custom.ToggleGroup>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginStart="16dp"
                android:background="@color/agri_semi_green"
                android:paddingHorizontal="8dp"
                android:text="@string/smells"
                android:textColor="@color/label_blue"
                android:textSize="18sp" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/moreInfoBLayout"
            android:layout_width="0dp"
            android:layout_height="260dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            app:layout_constraintBottom_toTopOf="@+id/moreInfoCLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/moreInfoALayout">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="12dp"
                android:background="@drawable/shape_rounded_corner_with_shadow"
                android:orientation="vertical"
                android:padding="1dp">

                <TextView
                    android:id="@+id/tvShinyLabel"
                    android:layout_width="220dp"
                    android:layout_height="35dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="16dp"
                    android:ems="10"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/shiny"
                    android:textAlignment="viewStart"
                    android:textColor="@color/label_blue"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toTopOf="@+id/tvBlurredLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <EditText
                    android:id="@+id/etShiny"
                    android:layout_width="70dp"
                    android:layout_height="35dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_rounded_dialog_input"
                    android:ems="10"
                    android:inputType="number"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textAlignment="viewEnd"
                    android:textColorHint="@color/black"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toTopOf="@+id/etBlurred"
                    app:layout_constraintStart_toEndOf="@+id/tvShinyLabel"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvShiny"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:paddingLeft="4dp"
                    android:text="%"
                    android:textAlignment="viewStart"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toBottomOf="@+id/etShiny"
                    app:layout_constraintStart_toEndOf="@+id/etShiny"
                    app:layout_constraintTop_toTopOf="@+id/etShiny" />

                <TextView
                    android:id="@+id/tvBlurredLabel"
                    android:layout_width="220dp"
                    android:layout_height="35dp"
                    android:layout_marginStart="8dp"
                    android:ems="10"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/blurred"
                    android:textAlignment="viewStart"
                    android:textColor="@color/label_blue"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toTopOf="@+id/tvHealedLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvShinyLabel" />

                <EditText
                    android:id="@+id/etBlurred"
                    android:layout_width="70dp"
                    android:layout_height="35dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_rounded_dialog_input"
                    android:ems="10"
                    android:inputType="number"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textAlignment="viewEnd"
                    android:textColorHint="@color/black"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toTopOf="@+id/etHealed"
                    app:layout_constraintStart_toEndOf="@+id/tvBlurredLabel"
                    app:layout_constraintTop_toBottomOf="@+id/etShiny" />

                <TextView
                    android:id="@+id/tvBlurred"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:paddingLeft="4dp"
                    android:text="%"
                    android:textAlignment="viewStart"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toBottomOf="@+id/etBlurred"
                    app:layout_constraintStart_toEndOf="@+id/etBlurred"
                    app:layout_constraintTop_toTopOf="@+id/etBlurred" />

                <TextView
                    android:id="@+id/tvHealedLabel"
                    android:layout_width="220dp"
                    android:layout_height="35dp"
                    android:layout_marginStart="8dp"
                    android:ems="10"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/healed"
                    android:textAlignment="viewStart"
                    android:textColor="@color/label_blue"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toTopOf="@+id/tvBlindLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvBlurredLabel" />

                <EditText
                    android:id="@+id/etHealed"
                    android:layout_width="70dp"
                    android:layout_height="35dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_rounded_dialog_input"
                    android:ems="10"
                    android:inputType="number"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textAlignment="viewEnd"
                    android:textColorHint="@color/black"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toTopOf="@+id/etBlind"
                    app:layout_constraintStart_toEndOf="@+id/tvHealedLabel"
                    app:layout_constraintTop_toBottomOf="@+id/etBlurred" />

                <TextView
                    android:id="@+id/tvHealed"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:paddingLeft="4dp"
                    android:text="%"
                    android:textAlignment="viewStart"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toBottomOf="@+id/etHealed"
                    app:layout_constraintStart_toEndOf="@+id/etHealed"
                    app:layout_constraintTop_toTopOf="@+id/etHealed" />

                <TextView
                    android:id="@+id/tvBlindLabel"
                    android:layout_width="220dp"
                    android:layout_height="35dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="8dp"
                    android:ems="10"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/blind"
                    android:textAlignment="viewStart"
                    android:textColor="@color/label_blue"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvHealedLabel" />

                <EditText
                    android:id="@+id/etBlind"
                    android:layout_width="70dp"
                    android:layout_height="35dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_rounded_dialog_input"
                    android:ems="10"
                    android:inputType="number"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textAlignment="viewEnd"
                    android:textColorHint="@color/black"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tvBlindLabel"
                    app:layout_constraintTop_toBottomOf="@+id/etHealed" />

                <TextView
                    android:id="@+id/tvBlind"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:paddingLeft="4dp"
                    android:text="%"
                    android:textAlignment="viewStart"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toBottomOf="@+id/etBlind"
                    app:layout_constraintStart_toEndOf="@+id/etBlind"
                    app:layout_constraintTop_toTopOf="@+id/etBlind" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginStart="16dp"
                android:background="@color/agri_semi_green"
                android:paddingHorizontal="8dp"
                android:text="@string/eye_evaluation"
                android:textColor="@color/label_blue"
                android:textSize="18sp" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/moreInfoCLayout"
            android:layout_width="0dp"
            android:layout_height="190dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/moreInfoBLayout">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="12dp"
                android:background="@drawable/shape_rounded_corner_with_shadow"
                android:orientation="vertical"
                android:padding="1dp">

                <TextView
                    android:id="@+id/tvCoherentLabel"
                    android:layout_width="220dp"
                    android:layout_height="35dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="16dp"
                    android:ems="10"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/coherent"
                    android:textAlignment="viewStart"
                    android:textColor="@color/label_blue"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toTopOf="@+id/tvSoftLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <EditText
                    android:id="@+id/etCoherent"
                    android:layout_width="70dp"
                    android:layout_height="35dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_rounded_dialog_input"
                    android:ems="10"
                    android:inputType="number"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textAlignment="viewEnd"
                    android:textColorHint="@color/black"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toTopOf="@+id/etSoft"
                    app:layout_constraintStart_toEndOf="@+id/tvCoherentLabel"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvCoherent"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:paddingLeft="4dp"
                    android:text="%"
                    android:textAlignment="viewStart"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toBottomOf="@+id/etCoherent"
                    app:layout_constraintStart_toEndOf="@+id/etCoherent"
                    app:layout_constraintTop_toTopOf="@+id/etCoherent" />

                <TextView
                    android:id="@+id/tvSoftLabel"
                    android:layout_width="220dp"
                    android:layout_height="35dp"
                    android:layout_marginStart="8dp"
                    android:ems="10"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/soft"
                    android:textAlignment="viewStart"
                    android:textColor="@color/label_blue"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toTopOf="@+id/tvSwollenLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvCoherentLabel" />

                <EditText
                    android:id="@+id/etSoft"
                    android:layout_width="70dp"
                    android:layout_height="35dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_rounded_dialog_input"
                    android:ems="10"
                    android:inputType="number"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textAlignment="viewEnd"
                    android:textColorHint="@color/black"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toTopOf="@+id/etSwollen"
                    app:layout_constraintStart_toEndOf="@+id/tvSoftLabel"
                    app:layout_constraintTop_toBottomOf="@+id/etCoherent" />

                <TextView
                    android:id="@+id/tvSoft"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:paddingLeft="4dp"
                    android:text="%"
                    android:textAlignment="viewStart"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toBottomOf="@+id/etSoft"
                    app:layout_constraintStart_toEndOf="@+id/etSoft"
                    app:layout_constraintTop_toTopOf="@+id/etSoft" />

                <TextView
                    android:id="@+id/tvSwollenLabel"
                    android:layout_width="220dp"
                    android:layout_height="35dp"
                    android:layout_marginStart="8dp"
                    android:ems="10"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/swollen"
                    android:textAlignment="viewStart"
                    android:textColor="@color/label_blue"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvSoftLabel" />

                <EditText
                    android:id="@+id/etSwollen"
                    android:layout_width="70dp"
                    android:layout_height="35dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_rounded_dialog_input"
                    android:ems="10"
                    android:inputType="number"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textAlignment="viewEnd"
                    android:textColorHint="@color/black"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tvSwollenLabel"
                    app:layout_constraintTop_toBottomOf="@+id/etSoft" />

                <TextView
                    android:id="@+id/tvSwollen"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:paddingLeft="4dp"
                    android:text="%"
                    android:textAlignment="viewStart"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toBottomOf="@+id/etSwollen"
                    app:layout_constraintStart_toEndOf="@+id/etSwollen"
                    app:layout_constraintTop_toTopOf="@+id/etSwollen" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginStart="16dp"
                android:background="@color/agri_semi_green"
                android:paddingHorizontal="8dp"
                android:text="@string/belly"
                android:textColor="@color/label_blue"
                android:textSize="18sp" />

        </RelativeLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/footerLayout"
        android:layout_width="0dp"
        android:layout_height="68sp"
        android:background="@drawable/border_top"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/formLayout">

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:scaleX="0.7"
            android:scaleY="0.7"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ivToPackageQualityMoreInfo3"
            app:layout_constraintStart_toEndOf="@+id/ivBackToPackageQualityMoreInfo"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/powered_by_agritrack" />

        <ImageView
            android:id="@+id/ivBackToPackageQualityMoreInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/button_rounded_shape_corners"
            android:padding="1dp"
            android:scaleX="1.5"
            android:scaleY="1.2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_shortcut_arrow_back" />

        <ImageView
            android:id="@+id/ivToPackageQualityMoreInfo3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:background="@drawable/button_rounded_shape_corners"
            android:padding="1dp"
            android:scaleX="1.5"
            android:scaleY="1.2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_shortcut_arrow_forward" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/list_item_bottom"
    android:clickable="true"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvSampleNUmber"
        android:layout_width="35dp"
        android:layout_height="wrap_content"
        android:paddingTop="3dp"
        android:gravity="center|bottom"
        android:textAlignment="center"
        android:textColor="@android:color/darker_gray"
        android:textSize="20sp"
        app:layout_constraintEnd_toStartOf="@+id/tvTime"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTime"
        android:layout_width="135dp"
        android:layout_height="match_parent"
        android:paddingTop="3dp"
        android:text="control time"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:gravity="center|bottom"
        android:textSize="20sp"
        app:layout_constraintEnd_toStartOf="@+id/tvFishTemp"
        app:layout_constraintStart_toEndOf="@id/tvSampleNUmber"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/tvFishTemp"
        android:layout_width="105dp"
        android:layout_height="wrap_content"
        android:paddingTop="3dp"
        android:textAlignment="center"
        android:layout_marginEnd="4dp"
        android:textColor="@color/black"
        android:gravity="center|bottom"
        android:textSize="20sp"
        app:layout_constraintEnd_toStartOf="@+id/tvWaterTemp"
        app:layout_constraintStart_toEndOf="@id/tvTime"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/tvWaterTemp"
        android:layout_width="95dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:paddingTop="3dp"
        android:textAlignment="center"
        android:gravity="center|bottom"
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tvFishTemp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
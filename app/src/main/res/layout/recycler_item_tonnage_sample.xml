<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/list_item_bottom"
    android:clickable="true"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvSampleNUmber"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:paddingTop="3dp"
        android:gravity="center|bottom"
        android:textAlignment="center"
        android:textColor="@android:color/darker_gray"
        android:textSize="24sp"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/tvTime"
        android:layout_width="170dp"
        android:layout_height="wrap_content"
        android:paddingTop="3dp"
        android:gravity="center|bottom"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="24sp"
        app:layout_constraintEnd_toStartOf="@+id/tvFishTemp"
        app:layout_constraintStart_toEndOf="@id/tvSampleNUmber"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvFishTemp"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:paddingTop="3dp"
        android:gravity="center|bottom"
        android:textColor="@color/black"
        android:text="T psariou 0C:"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tvTime"
        app:layout_constraintTop_toTopOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
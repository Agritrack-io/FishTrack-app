<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/list_item_bottom"
    android:clickable="true"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvRecyclerItemSNo"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:paddingTop="3dp"
        android:paddingEnd="15dp"
        android:textAlignment="viewEnd"
        android:textColor="@android:color/darker_gray"
        android:textSize="25sp"
        app:layout_constraintEnd_toStartOf="@+id/tvRecyclerItem"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvRecyclerItem"
        android:layout_width="230dp"
        android:layout_height="wrap_content"
        android:paddingTop="3dp"
        android:paddingRight="30dp"
        android:textAlignment="viewEnd"
        android:textColor="@color/black"
        android:textSize="25sp"
        app:layout_constraintEnd_toStartOf="@+id/tvCage"
        app:layout_constraintStart_toEndOf="@id/tvRecyclerItemSNo"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvCage"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:paddingTop="3dp"
        android:paddingRight="30dp"
        android:textAlignment="viewEnd"
        android:textColor="@color/black"
        android:textSize="25sp"
        app:layout_constraintEnd_toStartOf="@+id/tvWeight"
        app:layout_constraintStart_toEndOf="@id/tvRecyclerItem"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvWeight"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:paddingTop="3dp"
        android:paddingRight="30dp"
        android:textAlignment="viewEnd"
        android:textColor="@color/black"
        android:textSize="25sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tvCage"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
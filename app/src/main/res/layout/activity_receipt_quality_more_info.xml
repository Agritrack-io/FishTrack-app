<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:id="@+id/fishingBinsLayout"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="@color/agri_semi_green"
tools:context=".fish.ui.quality.receipt.ReceiptQualityMoreInfoActivity">

<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/headerLayout"
    android:layout_width="match_parent"
    android:layout_height="75dp"
    android:background="@drawable/bg_form_screen"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fadingEdge="horizontal"
    android:paddingTop="0dp"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <ImageView
        android:id="@+id/ivSupport"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/button_press_effect"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/support" />

    <TextView
        android:id="@+id/tvTitleToolbar"
        fontPath="fonts/open_sans_semibold.ttf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="16dp"
        android:width="250sp"
        android:gravity="center|top|fill_vertical"
        android:text="@string/title_quality_receipt"
        android:textColor="@color/yellow"
        android:textSize="@dimen/title_font_size"
        app:layout_constraintBottom_toTopOf="@+id/tvHeaderReceiptQualityMoreInfo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingPrefix" />

    <TextView
        android:id="@+id/tvHeaderReceiptQualityMoreInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/agri_blue"
        android:backgroundTintMode="screen"
        android:gravity="center"
        android:textColor="@color/agri_semi_green"
        android:textSize="@dimen/subtitle_font_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitleToolbar"
        tools:layout_conversion_absoluteHeight="0dp"
        tools:layout_conversion_absoluteWidth="0dp" />

</androidx.constraintlayout.widget.ConstraintLayout>

<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/formLayout"
    android:layout_width="0dp"
    android:layout_height="0dp"
    app:layout_constraintBottom_toTopOf="@+id/footerLayout"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@id/headerLayout">

    <RelativeLayout
        android:id="@+id/moreInfoALayout"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@+id/moreInfoBLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="12dp"
            android:background="@drawable/shape_rounded_corner_with_shadow"
            android:orientation="vertical"
            android:padding="1dp">

            <io.agritrack.ui.custom.ToggleGroup
                android:id="@+id/tgBinCondition"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ToggleButton
                    android:id="@+id/tbGoodBin"
                    android:layout_width="100dp"
                    android:layout_height="30dp"
                    android:layout_margin="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/togglebutton_selector"
                    android:gravity="center"
                    android:textColor="@drawable/button_text_color"
                    android:textOff="@string/good_condition"
                    android:textOn="@string/good_condition"
                    android:textSize="@dimen/text_view_font_size_medium" />

                <ToggleButton
                    android:id="@+id/tbMediumBin"
                    android:layout_width="100dp"
                    android:layout_height="30dp"
                    android:layout_margin="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/togglebutton_selector"
                    android:gravity="center"
                    android:textColor="@drawable/button_text_color"
                    android:textOff="@string/moderate_condition"
                    android:textOn="@string/moderate_condition"
                    android:textSize="@dimen/text_view_font_size_medium" />

                <ToggleButton
                    android:id="@+id/tbBadBin"
                    android:layout_width="100dp"
                    android:layout_height="30dp"
                    android:layout_margin="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/togglebutton_selector"
                    android:gravity="center"
                    android:textColor="@drawable/button_text_color"
                    android:textOff="@string/bad_condition"
                    android:textOn="@string/bad_condition"
                    android:textSize="@dimen/text_view_font_size_medium" />
            </io.agritrack.ui.custom.ToggleGroup>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginStart="16dp"
            android:layout_marginTop="0dp"
            android:background="@color/agri_semi_green"
            android:paddingHorizontal="8dp"
            android:text="@string/arrival_bin_condition"
            android:textColor="@color/label_blue"
            android:textSize="18sp" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/moreInfoBLayout"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@+id/moreInfoDLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/moreInfoALayout">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="12dp"
            android:background="@drawable/shape_rounded_corner_with_shadow"
            android:orientation="vertical"
            android:padding="1dp">

            <io.agritrack.ui.custom.ToggleGroup
                android:id="@+id/tgIceCondition"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ToggleButton
                    android:id="@+id/tbGoodIce"
                    android:layout_width="100dp"
                    android:layout_height="30dp"
                    android:layout_margin="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/togglebutton_selector"
                    android:gravity="center"
                    android:textColor="@drawable/button_text_color"
                    android:textOff="@string/good_condition"
                    android:textOn="@string/good_condition"
                    android:textSize="@dimen/text_view_font_size_medium" />

                <ToggleButton
                    android:id="@+id/tbMediumIce"
                    android:layout_width="100dp"
                    android:layout_height="30dp"
                    android:layout_margin="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/togglebutton_selector"
                    android:gravity="center"
                    android:textColor="@drawable/button_text_color"
                    android:textOff="@string/moderate_condition"
                    android:textOn="@string/moderate_condition"
                    android:textSize="@dimen/text_view_font_size_medium" />

                <ToggleButton
                    android:id="@+id/tbBadIce"
                    android:layout_width="100dp"
                    android:layout_height="30dp"
                    android:layout_margin="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/togglebutton_selector"
                    android:gravity="center"
                    android:textColor="@drawable/button_text_color"
                    android:textOff="@string/bad_condition"
                    android:textOn="@string/bad_condition"
                    android:textSize="@dimen/text_view_font_size_medium" />
            </io.agritrack.ui.custom.ToggleGroup>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginStart="16dp"
            android:background="@color/agri_semi_green"
            android:paddingHorizontal="8dp"
            android:text="@string/arrival_ice_condition"
            android:textColor="@color/label_blue"
            android:textSize="18sp" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/moreInfoDLayout"
        android:layout_width="0dp"
        android:layout_height="360dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/moreInfoBLayout">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="12dp"
            android:background="@drawable/shape_rounded_corner_with_shadow"
            android:orientation="vertical"
            android:padding="1dp">

            <TextView
                android:id="@+id/tvRigorMortisLabel"
                android:layout_width="220dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="16dp"
                android:ems="10"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/rigor_mortis"
                android:textAlignment="viewStart"
                android:textColor="@color/label_blue"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toTopOf="@+id/tvEliminationFoodLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/etRigorMortis"
                android:layout_width="70dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_rounded_dialog_input"
                android:ems="10"
                android:inputType="number"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textAlignment="viewEnd"
                android:textColorHint="@color/black"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toTopOf="@+id/etEliminationFood"
                app:layout_constraintStart_toEndOf="@+id/tvRigorMortisLabel"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvRigorMortis"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:paddingLeft="4dp"
                android:text="%"
                android:textAlignment="viewStart"
                android:textColor="@color/black"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toBottomOf="@+id/etRigorMortis"
                app:layout_constraintStart_toEndOf="@+id/etRigorMortis"
                app:layout_constraintTop_toTopOf="@+id/etRigorMortis" />

            <TextView
                android:id="@+id/tvEliminationFoodLabel"
                android:layout_width="220dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:ems="10"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/elimination_food"
                android:textAlignment="viewStart"
                android:textColor="@color/label_blue"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toTopOf="@+id/tvEliminationSpermLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvRigorMortisLabel" />

            <EditText
                android:id="@+id/etEliminationFood"
                android:layout_width="70dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_rounded_dialog_input"
                android:ems="10"
                android:inputType="number"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textAlignment="viewEnd"
                android:textColorHint="@color/black"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toTopOf="@+id/etEliminationSperm"
                app:layout_constraintStart_toEndOf="@+id/tvEliminationFoodLabel"
                app:layout_constraintTop_toBottomOf="@+id/etRigorMortis" />

            <TextView
                android:id="@+id/tvEliminationFood"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:paddingLeft="4dp"
                android:text="%"
                android:textAlignment="viewStart"
                android:textColor="@color/black"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toBottomOf="@+id/etEliminationFood"
                app:layout_constraintStart_toEndOf="@+id/etEliminationFood"
                app:layout_constraintTop_toTopOf="@+id/etEliminationFood" />

            <TextView
                android:id="@+id/tvEliminationSpermLabel"
                android:layout_width="220dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:ems="10"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/elimination_sperm"
                android:textAlignment="viewStart"
                android:textColor="@color/label_blue"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toTopOf="@+id/tvParasitesLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvEliminationFoodLabel" />

            <EditText
                android:id="@+id/etEliminationSperm"
                android:layout_width="70dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_rounded_dialog_input"
                android:ems="10"
                android:inputType="number"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textAlignment="viewEnd"
                android:textColorHint="@color/black"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toTopOf="@+id/etParasites"
                app:layout_constraintStart_toEndOf="@+id/tvEliminationSpermLabel"
                app:layout_constraintTop_toBottomOf="@+id/etEliminationFood" />

            <TextView
                android:id="@+id/tvEliminationSperm"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:paddingLeft="4dp"
                android:text="%"
                android:textAlignment="viewStart"
                android:textColor="@color/black"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toBottomOf="@+id/etEliminationSperm"
                app:layout_constraintStart_toEndOf="@+id/etEliminationSperm"
                app:layout_constraintTop_toTopOf="@+id/etEliminationSperm" />

            <TextView
                android:id="@+id/tvParasitesLabel"
                android:layout_width="220dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:ems="10"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/parasites"
                android:textAlignment="viewStart"
                android:textColor="@color/label_blue"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toTopOf="@+id/tvPeelingLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvEliminationSpermLabel" />

            <EditText
                android:id="@+id/etParasites"
                android:layout_width="70dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_rounded_dialog_input"
                android:ems="10"
                android:inputType="number"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textAlignment="viewEnd"
                android:textColorHint="@color/black"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toTopOf="@+id/etPeeling"
                app:layout_constraintStart_toEndOf="@+id/tvParasitesLabel"
                app:layout_constraintTop_toBottomOf="@+id/etEliminationSperm" />

            <TextView
                android:id="@+id/tvParasites"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:paddingLeft="4dp"
                android:text="%"
                android:textAlignment="viewStart"
                android:textColor="@color/black"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toBottomOf="@+id/etParasites"
                app:layout_constraintStart_toEndOf="@+id/etParasites"
                app:layout_constraintTop_toTopOf="@+id/etParasites" />

            <TextView
                android:id="@+id/tvPeelingLabel"
                android:layout_width="220dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:ems="10"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/peeling"
                android:textAlignment="viewStart"
                android:textColor="@color/label_blue"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvParasitesLabel" />

            <EditText
                android:id="@+id/etPeeling"
                android:layout_width="70dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_rounded_dialog_input"
                android:ems="10"
                android:inputType="number"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textAlignment="viewEnd"
                android:textColorHint="@color/black"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tvPeelingLabel"
                app:layout_constraintTop_toBottomOf="@+id/etParasites" />

            <TextView
                android:id="@+id/tvPeeling"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:paddingLeft="4dp"
                android:text="%"
                android:textAlignment="viewStart"
                android:textColor="@color/black"
                android:textSize="@dimen/text_view_font_size_medium"
                app:layout_constraintBottom_toBottomOf="@+id/etPeeling"
                app:layout_constraintStart_toEndOf="@+id/etPeeling"
                app:layout_constraintTop_toTopOf="@+id/etPeeling" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginStart="16dp"
            android:background="@color/agri_semi_green"
            android:paddingHorizontal="8dp"
            android:text="@string/percentages"
            android:textColor="@color/label_blue"
            android:textSize="18sp" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/footerLayout"
    android:layout_width="0dp"
    android:layout_height="68sp"
    android:background="@drawable/border_top"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/formLayout">

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:scaleX="0.7"
        android:scaleY="0.7"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ivToPackageQualityMoreInfo2"
        app:layout_constraintStart_toEndOf="@+id/ivBackToPackageQualityInfo"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/powered_by_agritrack" />

    <ImageView
        android:id="@+id/ivBackToPackageQualityInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:background="@drawable/button_rounded_shape_corners"
        android:padding="1dp"
        android:scaleX="1.5"
        android:scaleY="1.2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_shortcut_arrow_back" />

    <ImageView
        android:id="@+id/ivToPackageQualityMoreInfo2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:background="@drawable/button_rounded_shape_corners"
        android:padding="1dp"
        android:scaleX="1.5"
        android:scaleY="1.2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_shortcut_arrow_forward" />
</androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
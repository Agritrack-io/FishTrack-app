<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fishingStartActivityLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/agri_semi_green"
    tools:context=".fish.ui.quality.finalCheck.QualityFinalCheckConfirmActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:background="@drawable/bg_form_screen"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fadingEdge="horizontal"
        android:paddingTop="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivSupport"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/button_press_effect"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/support" />

        <TextView
            android:id="@+id/tvTitleToolbar"
            fontPath="fonts/open_sans_semibold.ttf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="16dp"
            android:width="250sp"
            android:gravity="center|top|fill_vertical"
            android:text="@string/final_quality_check"
            android:textAllCaps="true"
            android:textColor="@color/yellow"
            android:textSize="@dimen/title_font_size"
            app:layout_constraintBottom_toTopOf="@+id/tvHeaderFinalConfirm"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="MissingPrefix" />

        <TextView
            android:id="@+id/tvHeaderFinalConfirm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/agri_blue"
            android:backgroundTintMode="screen"
            android:gravity="center"
            android:textColor="@color/agri_semi_green"
            android:textSize="@dimen/subtitle_font_size"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitleToolbar"
            tools:layout_conversion_absoluteHeight="0dp"
            tools:layout_conversion_absoluteWidth="0dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/formLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/footerLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <RelativeLayout
            android:id="@+id/fishConfirmLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toTopOf="@id/fishEnterPinLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/formLayout">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="370dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/shape_rounded_corner_with_shadow"
                android:orientation="vertical"
                android:padding="15dp">


                <TextView
                    android:id="@+id/tvPackagingLotLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/confirm_lot_packaging"
                    android:textColor="@color/label_blue"
                    android:textSize="20sp"
                    app:layout_constraintBottom_toTopOf="@+id/tvEvaluationLabel"
                    app:layout_constraintEnd_toStartOf="@+id/tvPackagingLot"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvPackagingLot"
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/border_bottom"
                    android:textAlignment="viewEnd"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_view_font_size"
                    app:layout_constraintTop_toTopOf="@+id/tvPackagingLotLabel"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tvPackagingLotLabel"
                    app:layout_constraintBottom_toBottomOf="@+id/tvPackagingLotLabel" />

                <TextView
                    android:id="@+id/tvEvaluationLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/lot_fishing"
                    android:textColor="@color/label_blue"
                    android:textSize="20sp"
                    app:layout_constraintBottom_toTopOf="@id/tvStartTimeLabel"
                    app:layout_constraintEnd_toStartOf="@+id/tvFishLot"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvPackagingLotLabel" />

                <TextView
                    android:id="@+id/tvFishLot"
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/border_bottom"
                    android:textAlignment="viewEnd"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_view_font_size"
                    app:layout_constraintBottom_toBottomOf="@id/tvEvaluationLabel"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tvEvaluationLabel"
                    app:layout_constraintTop_toTopOf="@+id/tvEvaluationLabel" />


                <TextView
                    android:id="@+id/tvStartTimeLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/absence_of_foreign_bodies"
                    android:textColor="@color/label_blue"
                    android:textSize="20sp"
                    app:layout_constraintBottom_toTopOf="@id/etComments"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvEvaluationLabel" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swForeignBody"
                    android:layout_width="81dp"
                    android:layout_height="51dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="5dp"
                    android:checked="true"
                    android:scaleX="1"
                    android:scaleY="1.1"
                    android:showText="true"
                    android:textAlignment="center"
                    android:textColor="@color/label_blue"
                    android:textOff="@string/no"
                    android:textOn="@string/yes"
                    android:textSize="12dp"
                    android:theme="@style/SCBSwitch"
                    android:thumb="@drawable/thumb"
                    app:layout_constraintBottom_toBottomOf="@id/tvStartTimeLabel"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.504"
                    app:layout_constraintStart_toEndOf="@id/tvStartTimeLabel"
                    app:layout_constraintTop_toTopOf="@id/tvStartTimeLabel"
                    app:showText="true"
                    app:switchTextAppearance="@style/texton"
                    app:track="@drawable/track" />

                <EditText
                    android:id="@+id/etComments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:gravity="left|top"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="7dp"
                    android:visibility="gone"
                    android:background="@drawable/bg_rounded_dialog_input"
                    android:hint="@string/corrective_action"
                    android:textAlignment="gravity"
                    android:textColor="@color/label_blue"
                    android:textSize="18sp"
                    app:layout_constraintWidth_percent="0.8"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/tvLotAccepted"
                    app:layout_constraintTop_toBottomOf="@id/tvStartTimeLabel"/>

                <TextView
                    android:id="@+id/tvLotAccepted"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/lot_accepted"
                    android:textColor="@color/label_blue"
                    android:textSize="20sp"
                    app:layout_constraintBottom_toTopOf="@id/tvNotAcceptedLabel"
                    app:layout_constraintEnd_toStartOf="@+id/swIsAccepted"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/etComments" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swIsAccepted"
                    android:layout_width="81dp"
                    android:layout_height="51dp"
                    android:layout_marginEnd="25dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="5dp"
                    android:checked="true"
                    android:scaleX="1"
                    android:scaleY="1.1"
                    android:showText="true"
                    android:textAlignment="center"
                    android:textColor="@color/label_blue"
                    android:textOff="@string/no"
                    android:textOn="@string/yes"
                    android:textSize="12dp"
                    android:theme="@style/SCBSwitch"
                    android:thumb="@drawable/thumb"
                    app:layout_constraintBottom_toBottomOf="@id/tvLotAccepted"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.504"
                    app:layout_constraintStart_toEndOf="@id/tvLotAccepted"
                    app:layout_constraintTop_toTopOf="@id/tvLotAccepted"
                    app:showText="true"
                    app:switchTextAppearance="@style/texton"
                    app:track="@drawable/track" />

                <TextView
                    android:id="@+id/tvNotAcceptedLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:ems="10"
                    android:layout_marginTop="4dp"
                    android:text="@string/non_acceptable_quantity"
                    android:visibility="gone"
                    android:gravity="center|start"
                    android:textAlignment="viewStart"
                    android:textColor="@color/label_blue"
                    android:textSize="20sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvLotAccepted"
                    app:layout_constraintEnd_toStartOf="@id/etNotAccepted"
                    app:layout_constraintWidth_percent="0.6" />

                <EditText
                    android:id="@+id/etNotAccepted"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_rounded_dialog_input"
                    android:ems="4"
                    android:inputType="numberDecimal"
                    android:maxLength="3"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:visibility="gone"
                    android:textAlignment="center"
                    android:textColorHint="@color/black"
                    android:textSize="@dimen/text_view_font_size_medium"
                    app:layout_constraintBottom_toBottomOf="@id/tvNotAcceptedLabel"
                    app:layout_constraintStart_toEndOf="@+id/tvNotAcceptedLabel"
                    app:layout_constraintTop_toTopOf="@id/tvNotAcceptedLabel" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginStart="16dp"
                android:background="@color/agri_semi_green"
                android:paddingHorizontal="8dp"
                android:text="@string/fishing_confirm"
                android:textColor="@color/label_blue"
                android:textSize="18sp" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/fishEnterPinLayout"
            android:layout_width="0dp"
            android:layout_height="160dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fishConfirmLayout">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="12dp"
                android:background="@drawable/shape_rounded_corner_with_shadow"
                android:orientation="vertical"
                android:padding="15dp">

                <io.agritrack.philosofish.ui.custom.CaptureSignatureView
                    android:id="@+id/signatureView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_rounded_dialog_input"

                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginStart="16dp"
                android:background="@color/agri_semi_green"
                android:paddingHorizontal="8dp"
                android:text="@string/sign_manager"
                android:textColor="@color/label_blue"
                android:textSize="18sp" />

        </RelativeLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/footerLayout"
        android:layout_width="0dp"
        android:layout_height="68sp"
        android:background="@drawable/border_top"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/formLayout">

        <ImageView
            android:id="@+id/imageView4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:scaleX="0.7"
            android:scaleY="0.7"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ivToCongs"
            app:layout_constraintStart_toEndOf="@+id/ivBackFinalCheckStart"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/powered_by_agritrack" />

        <ImageView
            android:id="@+id/ivBackFinalCheckStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/button_rounded_shape_corners"
            android:padding="1dp"
            android:scaleX="1.5"
            android:scaleY="1.2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_shortcut_arrow_back" />

        <ImageView
            android:id="@+id/ivToCongs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:background="@drawable/button_rounded_shape_corners"
            android:padding="1dp"
            android:scaleX="1.5"
            android:scaleY="1.2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_check_blue" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
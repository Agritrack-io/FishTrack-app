<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="spinner_style">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/gradient_spinner</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

    <style name="SCBSwitch" parent="Theme.AppCompat.Light">
        <!-- active thumb & track color (30% transparency) -->
        <item name="colorControlActivated">#36BE25</item>

        <!-- inactive thumb color -->
        <item name="colorSwitchThumbNormal">#BD0F0F
        </item>

        <!-- inactive track color (30% transparency) -->
        <item name="android:colorForeground">@color/black
        </item>
    </style>

    <style name="texton" parent="Theme.AppCompat.Light">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">21sp</item>
    </style>

    <style name="Widget.App.ButtonStyle"
        parent="Widget.MaterialComponents.Button">
        <item name="materialThemeOverlay">@style/GreenButtonThemeOverlay</item>
        <item name="backgroundTint">@color/button_color_selector</item>
        <item name="android:textColor">@color/text_color_selector</item>
    </style>

    <style name="GreenButtonThemeOverlay">
        <item name="colorPrimary">@color/agri_blue</item>
    </style>

    <style name="AlertDialogCustom" parent="@android:style/Theme.Dialog">
        <item name="android:textColor">#00FF00</item>
        <item name="android:typeface">monospace</item>
        <item name="android:textSize">24sp</item>
    </style>
</resources>
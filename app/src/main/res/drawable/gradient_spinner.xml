<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#ffffff" />
                    <stroke android:width="2dp" android:color="@color/color_gray_border_dialog" />
                    <padding android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp" />
                    <corners android:radius="@dimen/margin10" />
                </shape>

            </item>
            <item android:width="35dp" android:height="35dp" android:gravity="end">
                <bitmap android:gravity="fill" android:src="@drawable/ic_shortcut_keyboard_arrow_down" android:mipMap="true" />
            </item>
        </layer-list>
    </item>
</selector>